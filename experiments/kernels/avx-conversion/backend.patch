diff --git a/cranelift/codegen/src/isa/x64/lower.isle b/cranelift/codegen/src/isa/x64/lower.isle
index 5fd71892a4..cdd1d6373c 100644
--- a/cranelift/codegen/src/isa/x64/lower.isle
+++ b/cranelift/codegen/src/isa/x64/lower.isle
@@ -2772,0 +2773,15 @@
+(decl pure can_reuse_fdiv_numerator (Inst Value Value) bool)
+(extern constructor can_reuse_fdiv_numerator can_reuse_fdiv_numerator)
+
+;; An AVX scalar conversion takes its upper lane from a separate register.
+;; When the only consumer is this division, it reads just the converted low
+;; lane and takes its own upper lane from the numerator. Reuse an invariant
+;; numerator already live here to avoid both a fresh zero and a loop-carried
+;; dependency on the previous conversion.
+(rule 1 (lower inst @ (fdiv $F64 numerator denominator @
+                         (fcvt_from_sint $F64 src @ (value_type (ty_int (ty_32_or_64 ty))))))
+      (if-let true (has_avx))
+      (if-let true (can_reuse_fdiv_numerator inst numerator denominator))
+      (let ((upper Xmm (put_in_xmm numerator)))
+        (x64_divsd upper (x64_cvtsi2sd ty upper src))))
+
diff --git a/cranelift/codegen/src/isa/x64/lower/isle.rs b/cranelift/codegen/src/isa/x64/lower/isle.rs
index ac9d7c5048..6ddfdfa7b7 100644
--- a/cranelift/codegen/src/isa/x64/lower/isle.rs
+++ b/cranelift/codegen/src/isa/x64/lower/isle.rs
@@ -20,2 +20,2 @@ use crate::machinst::{
-    ArgPair, CallArgList, CallInfo, CallRetList, InstOutput, MachInst, VCodeConstant,
-    VCodeConstantData,
+    ArgPair, CallArgList, CallInfo, CallRetList, InputSourceInst, InstOutput, MachInst,
+    VCodeConstant, VCodeConstantData,
@@ -468,0 +469,42 @@ impl Context for IsleContext<'_, '_, MInst, X64Backend> {
+    fn can_reuse_fdiv_numerator(
+        &mut self,
+        divide: Inst,
+        numerator: Value,
+        denominator: Value,
+    ) -> bool {
+        if self.backend.flags.opt_level() == crate::settings::OptLevel::None {
+            return false;
+        }
+        let func = self.lower_ctx.f;
+        let InputSourceInst::UniqueUse(convert, _) = self
+            .lower_ctx
+            .get_value_as_source_or_const(denominator)
+            .inst
+        else {
+            return false;
+        };
+        // Keep the conversion at the same point relative to trapping
+        // instructions, memory effects and other floating operations.
+        if func.layout.prev_inst(divide) != Some(convert) {
+            return false;
+        }
+        let Some(def) = func.dfg.value_def(numerator).inst() else {
+            return false;
+        };
+        // A locally computed numerator could add conversion latency to its
+        // own critical path. Restrict reuse to constants placed earlier.
+        if func.layout.inst_block(def) == func.layout.inst_block(divide) {
+            return false;
+        }
+        let data = &func.dfg.insts[def];
+        match data.opcode() {
+            Opcode::F64const => true,
+            Opcode::Extractlane => func
+                .dfg
+                .value_def(data.arguments(&func.dfg.value_lists)[0])
+                .inst()
+                .is_some_and(|vector| func.dfg.insts[vector].opcode() == Opcode::Vconst),
+            _ => false,
+        }
+    }
+
diff --git a/cranelift/filetests/filetests/isa/x64/fcvt-fdiv-avx.clif b/cranelift/filetests/filetests/isa/x64/fcvt-fdiv-avx.clif
new file mode 100644
index 0000000000..4400c7c218
--- /dev/null
+++ b/cranelift/filetests/filetests/isa/x64/fcvt-fdiv-avx.clif
@@ -0,0 +1,89 @@
+test compile
+test run
+set opt_level=speed
+set regalloc_checker=true
+target x86_64 has_avx
+
+;; The constant numerator already occupies a register across the loop. Its
+;; upper lane can be nonzero: the conversion's only consumer reads its low lane.
+function %loop_constant(i64, f64) -> f64 {
+block0(v0: i64, v1: f64):
+    v2 = vconst.f64x2 [0x1.0 0x2.0]
+    v3 = extractlane v2, 0
+    v4 = iconst.i64 0
+    v5 = iconst.i64 1
+    v14 = icmp sgt v0, v4
+    brif v14, block1(v0, v1), block2(v1)
+
+block1(v6: i64, v7: f64):
+    v8 = fcvt_from_sint.f64 v6
+    v9 = fdiv v3, v8
+    v10 = fadd v7, v9
+    v11 = isub v6, v5
+    v12 = icmp sgt v11, v4
+    brif v12, block1(v11, v10), block2(v10)
+
+block2(v13: f64):
+    return v13
+}
+
+; not: vxorpd
+; check: vcvtsi2sdq
+; check: vdivsd
+; run: %loop_constant(2, 0x1.0) == 0x1.4p1
+; run: %loop_constant(0, -0x0.0) == -0x0.0
+
+;; Keep the same hoisted vector constant and loop as in %loop_constant.
+;; The second use must share the conversion with the division.
+function %shared_denominator(i64, f64) -> f64 {
+block0(v0: i64, v1: f64):
+    v2 = vconst.f64x2 [0x1.0 0x2.0]
+    v3 = extractlane v2, 0
+    v4 = iconst.i64 0
+    v5 = iconst.i64 1
+    v14 = icmp sgt v0, v4
+    brif v14, block1(v0, v1), block2(v1)
+
+block1(v6: i64, v7: f64):
+    v8 = fcvt_from_sint.f64 v6
+    v9 = fdiv v3, v8
+    v15 = fadd v7, v8
+    v10 = fadd v9, v15
+    v11 = isub v6, v5
+    v12 = icmp sgt v11, v4
+    brif v12, block1(v11, v10), block2(v10)
+
+block2(v13: f64):
+    return v13
+}
+
+; not: vcvtsi2sdq
+; check: vxorpd
+; check: vcvtsi2sdq
+; not: vcvtsi2sdq
+; check: vdivsd
+; not: vcvtsi2sdq
+; run: %shared_denominator(2, 0x1.0) == 0x1.6p2
+
+;; A loop-carried numerator would serialize the conversion with the recurrence.
+function %loop_carried_numerator(i32, f64) -> f64 {
+block0(v0: i32, v1: f64):
+    v2 = iconst.i32 0
+    v3 = iconst.i32 1
+    jump block1(v0, v1)
+
+block1(v4: i32, v5: f64):
+    v6 = fcvt_from_sint.f64 v4
+    v7 = fdiv v5, v6
+    v8 = isub v4, v3
+    v9 = icmp sgt v8, v2
+    brif v9, block1(v8, v7), block2(v7)
+
+block2(v10: f64):
+    return v10
+}
+
+; check: vxorpd
+; check: vcvtsi2sdl
+; check: vdivsd
+; run: %loop_carried_numerator(2, 0x1.0) == 0x1.0p-1
