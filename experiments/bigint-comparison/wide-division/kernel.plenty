# The production radix-2^64 trial-product row.
def subtract_wide_product(row: &mut [u64], v: &[u64], q: u64) -> u64:
    mut borrow = 0u64
    for i in range(len(row)):
        (lo, hi) = q.widening_mul(v[i])
        (sum, carry0) = lo.carrying_add(borrow, False)
        (difference, carry1) = sum.carrying_add(row[i] ^ u64.MAX, False)
        row[i] = difference ^ u64.MAX
        borrow = hi.wrapping_add(1u64 if carry0 else 0u64).wrapping_add(1u64 if carry1 else 0u64)
    borrow

def main() -> Result[(), AllocError | IoError | ParseError]:
    argv = args()?
    count = i64.parse(argv[1])?
    guess = u64.parse(argv[2])?
    mut row = [u64.MAX.wrapping_sub(u64(i)) for i in range(1024)]?
    divisor = [u64.MAX ^ u64(i).wrapping_mul(15261831u64) for i in range(1024)]?
    mut borrow = 0u64
    for _ in range(count):
        borrow = subtract_wide_product(&mut row, &divisor, guess)
    mut checksum = 0u64
    for word in &row:
        checksum = checksum.wrapping_mul(31u64).wrapping_add(*word)
    print(borrow, checksum)?
    Ok(())
