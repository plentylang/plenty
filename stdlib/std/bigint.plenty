                carry = high + borrow_bit(sum, low, previous) + borrow_bit(total, sum, carry)
            out[i + len(b)] = carry

def quotient_remainder(a: &BigInt, b: &BigInt) -> Result[(BigInt, BigInt), AllocError]:
    match &a._value:
        case Value.Small(x):
            match &b._value:
                case Value.Small(y):
                    result = checked:
                        (*x // *y, *x % *y)
                    match result:
                        case Ok(pair):
                            (q, r) = pair
                            return Ok((from_i64(q), from_i64(r)))
                        case Err(_):
                            pass
                case _:
                    pass
        case _:
            pass
    (quotient, rest) = divide_magnitude(a, b)?
    mut q = canonical(a.is_negative() != b.is_negative(), quotient)
    mut remainder = canonical(False, rest)
    if a.is_negative() != b.is_negative() and not remainder.is_zero():
        q = (q - from_i64(1))?
        remainder = canonical(b.is_negative(), magnitude_sub(b, &remainder)?)
    elif b.is_negative() and not remainder.is_zero():
        remainder = (-remainder)?
    Ok((q, remainder))

# The short-division fallback uses radix 2^32 scratch for magnitudes
# stored in radix 2^64.
def digits32(value: &BigInt) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = list[u64].with_capacity(value.word_len() * 2)?
        for i in range(value.word_len()):
            out.append(value.word(i) & 4294967295u64)?
            out.append(value.word(i) >> 32u64)?
        trim(&mut out)
        Ok(out)

def pack32(digits: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = list[u64].with_capacity((len(digits) + 1) // 2)?
        mut i = 0
        while i < len(digits):
            high = digits[i + 1] if i + 1 < len(digits) else 0u64
            out.append(digits[i] | (high << 32u64))?
            i += 2
        Ok(out)

def scale32(digits: &mut list[u64], factor: u64) -> Result[(), AllocError]:
    unchecked:
        mut carry = 0u64
        for i in range(len(digits)):
            value = digits[i] * factor + carry
            digits[i] = value & 4294967295u64
            carry = value >> 32u64
        if carry != 0u64:
            digits.append(carry)?
        Ok(())

const WIDE_DIVISION_LIMBS: i64 = 2
# Quotient-block sizes are measured in significant normalized limbs.
const DIVISION_BLOCK_LIMBS: i64 = 768
const RADIX_DIVISION_BLOCK_LIMBS: i64 = 1200
const RADIX_RECIPROCAL_LIMBS: i64 = 2049
const RECIPROCAL_TAIL_LIMBS: i64 = 768

def divide_magnitude(a: &BigInt, b: &BigInt) -> Result[(list[u64], list[u64]), AllocError]:
    if b.word_len() >= WIDE_DIVISION_LIMBS and magnitude_cmp(a, b) >= 0:
        divisor = prepare_wide_divisor(b)?
        return divide_wide(a, &divisor)
    divide_narrow(a, b)

# Normalize to a top limb of at least 2^63, omitting exactly zero low
# divisor limbs. Store the extra numerator limb even when there is no carry.
def normalize_division(value: &BigInt, first: i64, shift: u64, extra: i64) -> Result[list[u64], AllocError]:
    unchecked:
        count = value.word_len() - first
        mut out = zeros(count + extra)?
        if shift == 0u64:
            for i in range(count):
                out[i] = value.word(first + i)
        else:
            mut carry = 0u64
            for i in range(count):
                word = value.word(first + i)
                out[i] = (word << shift) | carry
                carry = word >> (64u64 - shift)
            if extra != 0:
                out[count] = carry
        Ok(out)

def inverse_division_word(divisor: u64) -> u64:
    # The high limb of B^2-1 yields quotient one. Start with its
    # remainder and shift in the 64 ones of the low limb.
    mut inverse = 0u64
    mut remainder = divisor ^ u64.MAX
    for _ in range(64):
        doubled = (remainder << 1u64) | 1u64
        subtract = (remainder >> 63u64) != 0u64 or doubled >= divisor
        remainder = doubled.wrapping_sub(divisor) if subtract else doubled
        inverse = (inverse << 1u64) | (1u64 if subtract else 0u64)
    inverse

# The leading one of the fixed-point reciprocal is implicit. The
# cyclic correction product uses modulus B^cyclic_words - 1.
class RadixReciprocal:
    digits: list[u64]
    cyclic_words: i64

# The omitted low limbs are zero in the divisor, so the corresponding
# low dividend limbs pass directly to the remainder.
class WideDivisor:
    first: i64
    shift: u64
    digits: list[u64]
    inverse: u64
    reciprocal: Option[RadixReciprocal]

    def prepare_radix_reciprocal(self: &mut WideDivisor, dividend_limbs: i64) -> Result[(), AllocError]:
        unchecked:
            n = len(self.digits)
            if n < RADIX_RECIPROCAL_LIMBS or self.reciprocal.is_some() or n >= MAX_TRANSFORM_WORDS:
                return Ok(())
            quotient_limbs = dividend_limbs - self.first - n
            # The cyclic reciprocal path pays for itself on repeated
            # splits whose quotient is wider after low zero limbs are
            # omitted. Divide the quotient into roughly equal blocks.
            if quotient_limbs <= n + n // 4:
                return Ok(())
            half_cyclic = power_of_two_at_most(n)
            cyclic = 2 * half_cyclic
            target = (quotient_limbs + 1) // 2
            block = half_cyclic if half_cyclic > target else target
            width = block if block < n else n - 1
            if n + width > cyclic and quotient_limbs >= width:
                digits = division_reciprocal(&self.digits, width)?
                self.reciprocal = Some(RadixReciprocal(digits, cyclic))
            Ok(())

def prepare_wide_divisor(value: &BigInt) -> Result[WideDivisor, AllocError]:
    unchecked:
        mut first = 0
        while value.word(first) == 0u64:
            first += 1
        shift = u64((64 - value.bit_length() % 64) % 64)
        digits = normalize_division(value, first, shift, 0)?
        inverse = inverse_division_word(digits[-1])
        Ok(WideDivisor(first, shift, digits, inverse, Nothing))

def divide_wide(a: &BigInt, b: &WideDivisor, block_limbs: i64 = DIVISION_BLOCK_LIMBS) -> Result[(list[u64], list[u64]), AllocError]:
    unchecked:
        first = b.first
        shift = b.shift
        n = len(b.digits)
        mut u = normalize_division(a, first, shift, 1)?
        mut q = zeros(len(u) - n)?
        match &b.reciprocal:
            case Some(reciprocal):
                divide_reciprocal_digits(&mut u, &b.digits, &mut q, b.inverse, reciprocal)?
            case Nothing:
                divide_normalized(&mut u, &b.digits, &mut q, b.inverse, block_limbs)?
        mut r = zeros(first + n)?
        for i in range(first):
            r[i] = a.word(i)
        if shift == 0u64:
            for i in range(n):
                r[first + i] = u[i]
        else:
            for i in range(n - 1):
                r[first + i] = (u[i] >> shift) | (u[i + 1] << (64u64 - shift))
            r[-1] = u[n - 1] >> shift
        Ok((q, r))

# With B = 2^64 and hi < d, floor((hi*B+lo)*(B+inverse)/B^2)
# is at most one below the exact quotient. The three-term carry from
# hi*inverse + lo + high(lo*inverse) forms the high half of this product.
# Use q*d to correct the quotient and obtain the remainder.
def estimate_division_word(hi: u64, lo: u64, d: u64, inverse: u64) -> (u64, u64):
    (p0, p1) = hi.widening_mul(inverse)
    (_, p2) = lo.widening_mul(inverse)
    (sum, carry0) = p0.carrying_add(lo, False)
    (_, carry1) = sum.carrying_add(p2, False)
    q = hi.wrapping_add(p1).wrapping_add(1u64 if carry0 else 0u64).wrapping_add(1u64 if carry1 else 0u64)
    (low, high) = q.widening_mul(d)
    r = lo.wrapping_sub(low)
    overflow = hi != high.wrapping_add(1u64 if lo < low else 0u64)
    if overflow or r >= d:
        (q.wrapping_add(1u64), r.wrapping_sub(d))
    else:
        (q, r)

def divide_normalized(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64, block_limbs: i64) -> Result[(), AllocError]:
    unchecked:
        n = len(v)
        high = len(q) - 1
        if n < 2 * block_limbs or high < block_limbs or high < n // 2:
            divide_wide_digits(u, v, q, inverse)
            return Ok(())
        # The extra dividend limb may be nonzero after normalization.
        # Resolve the top quotient limb to make the n-limb remainder < v.
        divide_wide_digits(&mut u[high:], v, &mut q[high:], inverse)
        mut scratch = zeros(n)?
        divide_blocked_digits(&mut u[:high + n], v, &mut q[:high], inverse, &mut scratch)

# Divide successive quotient blocks from most significant to least. The
# low half omitted by the recursive estimate is restored by multiplication.
def divide_blocked_digits(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64, scratch: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        n = len(v)
        mut high = len(q)
        while high > 0:
            if n < 2 * DIVISION_BLOCK_LIMBS or high < DIVISION_BLOCK_LIMBS:
                divide_wide_digits(&mut u[:n + high], v, &mut q[:high], inverse)
                return Ok(())
            half = (n + 1) // 2
            k = half if half < high else high
            offset = high - k
            first = n - k
            start = offset + first
            top = &v[first:]
            mut carry = False
            if compare_division_words(&u[high + first:high + n], top) == 0:
                # The true quotient fits k limbs. Clamp its estimate to
                # B^k-1; the truncated remainder is the low k limbs plus top.
                for i in range(k):
                    q[offset + i] = u64.MAX
                carry = add_division_words(&mut u[start:start + k], top)
            else:
                divide_blocked_digits(&mut u[start:high + n], top, &mut q[offset:high], inverse, scratch)?
            product = &mut scratch[:n]
            clear_words(product)
            multiply_into(&q[offset:high], &v[:first], product)?
            # Only the clamped prefix remainder can have an extra limb.
            # A negative difference needs at most two additions of v.
            row = &mut u[offset:offset + n]
            borrow = subtract_division_words(row, product)
            mut negative = not carry and borrow != 0u64
            while negative:
                decrement_words(&mut q[offset:high])
                negative = not add_division_words(row, v)
            high = offset
        Ok(())

def compare_division_words(a: &[u64], b: &[u64]) -> i64:
    unchecked:
        mut i = len(b)
        while i > 0:
            i -= 1
            if a[i] != b[i]:
                return -1 if a[i] < b[i] else 1
        0

def clear_words(words: &mut [u64]) -> ():
    for word in words:
        *word = 0u64

def decrement_words(words: &mut [u64]) -> ():
    for word in words:
        *word = (*word).wrapping_sub(1u64)
        if *word != u64.MAX:
            break

def increment_words(words: &mut [u64]) -> bool:
    for word in words:
        *word = (*word).wrapping_add(1u64)
        if *word != 0u64:
            return False
    True

def add_division_words(row: &mut [u64], words: &[u64]) -> bool:
    mut carry = False
    for i in range(len(row)):
        (sum, overflow) = row[i].carrying_add(words[i], carry)
        row[i] = sum
        carry = overflow
    carry

def subtract_division_words(row: &mut [u64], words: &[u64]) -> u64:
    mut borrow = 0u64
    for i in range(len(row)):
        a = row[i]
        b = words[i]
        partial = a.wrapping_sub(b)
        difference = partial.wrapping_sub(borrow)
        row[i] = difference
        borrow = borrow_bit(a, b, partial) | borrow_bit(partial, borrow, difference)
    borrow

def power_of_two_at_most(n: i64) -> i64:
    unchecked:
        mut k = 1
        while k <= n // 2:
            k *= 2
        k

# Divide by the rounded-up k+1 limb prefix and discard one guard limb.
# This gives a lower bound on B^(n+k)/v with error less than two.
def division_reciprocal(v: &[u64], k: i64) -> Result[list[u64], AllocError]:
    unchecked:
        width = k + 1
        mut prefix = v[len(v) - width:]?
        if increment_words(&mut prefix):
            return zeros(k)
        mut numerator = [u64.MAX for _ in range(2 * width)]?
        mut full = zeros(width)?
        mut scratch = zeros(width)?
        # The upper width limbs of B^(2*width)-1 are at least the prefix.
        # The implicit high quotient limb is therefore one.
        drop(subtract_division_words(&mut numerator[width:], &prefix))
        divide_blocked_digits(&mut numerator, &prefix, &mut full, inverse_division_word(prefix[-1]), &mut scratch)?
        Ok(full[1:]?)

# Evaluate the correction modulo B^width-1 with a cyclic convolution.
# The actual nonnegative remainder is smaller than 5v, which fits below
# the modulus since width is at least one limb longer than the divisor.
def subtract_cyclic_product(u: &mut [u64], v: &[u64], q: &[u64], product: &mut [u64], folded: &mut [u64]) -> Result[u64, AllocError]:
    unchecked:
        width = len(product)
        multiply_transform_wide_into(v, q, product, True)?
        copy_words(&u[:width], folded)
        high = len(u) - width
        if add_division_words(&mut folded[:high], &u[width:]) and increment_words(&mut folded[high:]):
            drop(increment_words(folded))
        if subtract_division_words(folded, product) != 0u64:
            decrement_words(folded)
        n = len(v)
        if folded[n] == u64.MAX:
            clear_words(&mut u[:n])
            return Ok(0u64)
        copy_words(folded, &mut u[:n])
        Ok(folded[n])

# H is the high k limbs of the current remainder. The next quotient
# block is at least floor(H * (B^k + reciprocal) / B^k). Subtract its
# product with the divisor and advance the estimate until the remainder
# is smaller than the divisor.
def divide_reciprocal_digits(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64, reciprocal: &RadixReciprocal) -> Result[(), AllocError]:
    unchecked:
        n = len(v)
        width = len(reciprocal.digits)
        cyclic = reciprocal.cyclic_words
        mut high = len(q) - 1
        if high < RECIPROCAL_TAIL_LIMBS or n + high <= cyclic:
            return divide_normalized(u, v, q, inverse, RADIX_DIVISION_BLOCK_LIMBS)
        divide_wide_digits(&mut u[high:], v, &mut q[high:], inverse)
        product_size = 2 * width if 2 * width > cyclic else cyclic
        mut scratch = zeros(product_size)?
        mut folded = zeros(cyclic)?
        while high > 0:
            k = width if width < high else high
            if k < RECIPROCAL_TAIL_LIMBS or n + k <= cyclic:
                divide_wide_digits(&mut u[:n + high], v, &mut q[:high], inverse)
                break
            offset = high - k
            top = &u[high + n - k:high + n]
            product = &mut scratch[:2 * k]
            clear_words(product)
            multiply_into(top, &reciprocal.digits[width - k:], product)?
            quotient = &mut q[offset:high]
            copy_words(top, quotient)
            drop(add_division_words(quotient, &product[k:]))
            mut upper = subtract_cyclic_product(&mut u[offset:high + n], v, quotient, &mut scratch[:cyclic], &mut folded)?
            row = &mut u[offset:offset + n]
            while upper != 0u64 or compare_division_words(row, v) >= 0:
                drop(increment_words(quotient))
                upper = upper.wrapping_sub(subtract_division_words(row, v))
            high = offset
        Ok(())

def divide_wide_digits(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64) -> ():
    unchecked:
        n = len(v)
        divisor = v[n - 1]
        mut j = len(q)
        while j > 0:
            j -= 1
            hi = u[j + n]
            lo = u[j + n - 1]
            mut guess = u64.MAX
            mut residual = lo.wrapping_add(divisor)
            mut residual_wide = residual < lo
            if hi != divisor:
                (trial, rem) = estimate_division_word(hi, lo, divisor, inverse)
                guess = trial
                residual = rem
                residual_wide = False
            if n > 1:
                next = u[j + n - 2]
                while not residual_wide:
                    (low, high) = guess.widening_mul(v[n - 2])
                    if high < residual or (high == residual and low <= next):
                        break
                    guess -= 1u64
                    updated = residual.wrapping_add(divisor)
                    residual_wide = updated < residual
                    residual = updated
            # This high limb is outside every later row. Only its borrow
            # determines whether the divisor must be added back.
            row = &mut u[j:j + n]
            borrow = subtract_wide_product(row, v, guess)
            if hi < borrow:
                mut carry = False
                for i in range(n):
                    (word, overflow) = row[i].carrying_add(v[i], carry)
                    row[i] = word
                    carry = overflow
                guess -= 1u64
            q[j] = guess

# Subtract the low product and the incoming borrow in two steps. Add
# each step's borrow bit to the high product. Each bit follows from the
# signs of a, b and a-b: when a and b have different top bits, borrow if
# b has the top bit set. When they agree, use the top bit of a-b.
# Computing the bits arithmetically keeps both subtractions branch-free.
def subtract_wide_product(row: &mut [u64], v: &[u64], q: u64) -> u64:
    mut borrow = 0u64
    for i in range(len(row)):
        (lo, hi) = q.widening_mul(v[i])
        old = row[i]
        difference = old.wrapping_sub(lo)
        result = difference.wrapping_sub(borrow)
        first = borrow_bit(old, lo, difference)
        second = borrow_bit(difference, borrow, result)
        row[i] = result
        borrow = hi.wrapping_add(first).wrapping_add(second)
    borrow

def borrow_bit(a: u64, b: u64, difference: u64) -> u64:
    complement = a ^ u64.MAX
    ((b & complement) | ((b | complement) & difference)) >> 63u64

# Single stored limbs keep the base-2^32 Algorithm D path.
def divide_narrow(a: &BigInt, b: &BigInt) -> Result[(list[u64], list[u64]), AllocError]:
    unchecked:
        if magnitude_cmp(a, b) < 0:
            empty: list[u64] = []?
            return Ok((empty, words(a)?))
        mut u = digits32(a)?
        mut v = digits32(b)?
        n = len(v)
        m = len(u) - n
        factor = 4294967296u64 // (v[-1] + 1u64)
        if factor != 1u64:
            scale32(&mut u, factor)?
            scale32(&mut v, factor)?
        if len(u) == m + n:
            u.append(0u64)?
        mut q = zeros(m + 1)?
        divide_digits(&mut u, &v, &mut q)
        r = &mut u[:n]
        if factor != 1u64:
            mut carry = 0u64
            mut i = n
            while i > 0:
                i -= 1
                value = (carry << 32u64) | r[i]
                r[i] = value // factor
                carry = value % factor
        Ok((pack32(&q)?, pack32(&r)?))

# Hold scratch row addresses for the complete quotient loop. No list can grow
# while these views exist; normalization and allocation happen in the caller.
def divide_digits(u: &mut [u64], v: &[u64], q: &mut [u64]) -> ():
    unchecked:
        n = len(v)
        m = len(q) - 1
        mut j = m + 1
        while j > 0:
            j -= 1
            numerator = (u[j + n] << 32u64) | u[j + n - 1]
            mut guess = numerator // v[n - 1]
            mut residual = numerator % v[n - 1]
            if guess >= 4294967296u64:
                guess = 4294967295u64
                residual = u[j + n - 1] + v[n - 1]
            if n > 1:
                while residual < 4294967296u64 and guess * v[n - 2] > (residual << 32u64) + u[j + n - 2]:
                    guess -= 1u64
                    residual += v[n - 1]
                    if residual >= 4294967296u64:
                        break
            borrow = subtract_digit_product(&mut u[j:j + n], v, guess)
            negative = u[j + n] < borrow
            u[j + n] = u[j + n].wrapping_sub(borrow) & 4294967295u64
            if negative:
                guess -= 1u64
                mut carry = 0u64
                for i in range(n):
                    total = u[j + i] + v[i] + carry
                    u[j + i] = total & 4294967295u64
                    carry = total >> 32u64
                u[j + n] = (u[j + n] + carry) & 4294967295u64
            q[j] = guess

# In base B = 2^32, complementing the current digit turns subtraction
# into addition: guess*v[i] + borrow + (B-1-row[i]). Its low digit is
# the complement of the result digit, and its high digit is the new borrow.
# The sum is at most (B-1)^2 + 2*(B-1) = B^2-1, so these operations fit u64.
def subtract_digit_product(row: &mut [u64], v: &[u64], guess: u64) -> u64:
    mut borrow = 0u64
    for i in range(len(row)):
        digit = row[i] ^ 4294967295u64
        total = guess.wrapping_mul(v[i]).wrapping_add(borrow).wrapping_add(digit)
        row[i] = (total ^ 4294967295u64) & 4294967295u64
        borrow = total >> 32u64
    borrow

def bitwise(a: &BigInt, b: &BigInt, operation: i64) -> Result[BigInt, AllocError]:
    match &a._value:
        case Value.Small(x):
            match &b._value:
                case Value.Small(y):
                    result = (*x & *y) if operation == 0 else ((*x | *y) if operation == 1 else (*x ^ *y))
                    return Ok(from_i64(result))
                case _:
                    pass
        case _:
            pass
    unchecked:
        n = (a.word_len() if a.word_len() > b.word_len() else b.word_len()) + 1
        mut out = zeros(n)?
        mut ac = a.is_negative()
        mut bc = b.is_negative()
        for i in range(n):
            aw = a.word(i)
            bw = b.word(i)
            (ax, next_a) = (~aw).carrying_add(0u64, ac) if a.is_negative() else (aw, False)
            (bx, next_b) = (~bw).carrying_add(0u64, bc) if b.is_negative() else (bw, False)
            ac = next_a
            bc = next_b
            out[i] = (ax & bx) if operation == 0 else ((ax | bx) if operation == 1 else (ax ^ bx))
        negative = (out[-1] >> 63u64) != 0u64
        if negative:
            mut carry = True
            for i in range(n):
                (word, next) = (~out[i]).carrying_add(0u64, carry)
                out[i] = word
                carry = next
        Ok(canonical(negative, out))
