# Arbitrary precision signed integers. Canonical signed magnitude with inline i64.
# Arithmetic algorithms follow the base-power limb approach described in
# The Art of Computer Programming, vol. 2, sections 4.3.1 and 4.3.3
# (Donald Knuth): schoolbook arithmetic, Knuth division, Karatsuba and Toom-3.
# Large multiplication independently implements small-prime NTT/CRT, with
# 128-bit digit packing and exact Montgomery reduction:
# https://flintlib.org/doc/algorithms/fft/multimodular.html
# Malachite 0.14 informed grouped conversion, bit packing, radix-power squaring,
# recursive quotient blocks and cached Barrett reciprocals with cyclic products.
# No third-party code or data is included.
from std.bytes import to_text, BytesError
from std.fmt import Formatter, FormatError

@copy
pub enum BigIntError:
    InvalidDigit
    InvalidRadix
    LimitExceeded
    OutOfRange
    ZeroDivision
    Allocation(AllocError)

enum Value:
    Small(i64)
    Large(bool, list[u64])

pub class BigInt:
    _value: Value

    pub def is_zero(self) -> bool:
        match &self._value:
            case Value.Small(n):
                *n == 0
            case Value.Large(_, _):
                False

    pub def is_negative(self) -> bool:
        match &self._value:
            case Value.Small(n):
                *n < 0
            case Value.Large(negative, _):
                *negative

    def word_len(self) -> i64:
        match &self._value:
            case Value.Small(n):
                0 if *n == 0 else 1
            case Value.Large(_, words):
                len(words)

    def word(self, index: i64) -> u64:
        if index < 0 or index >= self.word_len():
            return 0u64
        match &self._value:
            case Value.Small(n):
                unchecked:
                    u64(-(*n + 1)) + 1u64 if *n < 0 else u64(*n)
            case Value.Large(_, words):
                words[index]

    pub def cmp(self, other: &BigInt) -> i64:
        if self.is_negative() != other.is_negative():
            return -1 if self.is_negative() else 1
        result = magnitude_cmp(self, other)
        unchecked:
            -result if self.is_negative() else result

    pub def to_i64(self) -> Result[i64, BigIntError]:
        match &self._value:
            case Value.Small(n):
                Ok(*n)
            case Value.Large(_, _):
                Err(BigIntError.OutOfRange)

    pub def to_u64(self) -> Result[u64, BigIntError]:
        if self.is_negative() or self.word_len() > 1:
            return Err(BigIntError.OutOfRange)
        Ok(self.word(0))

    pub def bit_length(self) -> i64:
        if self.is_zero():
            return 0
        unchecked:
            mut high = self.word(self.word_len() - 1)
            mut bits = (self.word_len() - 1) * 64
            while high != 0u64:
                bits += 1
                high >>= 1u64
            bits

    pub def to_f64(self) -> f64:
        unchecked:
            bits = self.bit_length()
            if bits <= 53:
                value = f64(self.word(0))
                return -value if self.is_negative() else value
            if bits > 1024:
                return -f64.INF if self.is_negative() else f64.INF
            shift = bits - 53
            mut top = 0u64
            for i in range(53):
                position = bits - i - 1
                top = (top << 1u64) | ((self.word(position // 64) >> u64(position % 64)) & 1u64)
            guard_position = shift - 1
            guard = ((self.word(guard_position // 64) >> u64(guard_position % 64)) & 1u64) != 0u64
            mut sticky = False
            for i in range(guard_position // 64):
                sticky = sticky or self.word(i) != 0u64
            remaining = u64(guard_position % 64)
            if remaining != 0u64:
                sticky = sticky or (self.word(guard_position // 64) << (64u64 - remaining)) != 0u64
            if guard and (sticky or (top & 1u64) != 0u64):
                top += 1u64
            value = f64(top) * 2.0.pow(f64(shift))
            -value if self.is_negative() else value

    pub def __add__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a + *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        if self.is_negative() == other.is_negative():
            return Ok(canonical(self.is_negative(), magnitude_add(self, other)?))
        order = magnitude_cmp(self, other)
        if order == 0:
            return Ok(from_i64(0))
        if order > 0:
            Ok(canonical(self.is_negative(), magnitude_sub(self, other)?))
        else:
            Ok(canonical(other.is_negative(), magnitude_sub(other, self)?))

    pub def __radd__(self, other: i64) -> Result[BigInt, AllocError]:
        self + from_i64(other)

    pub def __neg__(self) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(n):
                if *n != i64.MIN:
                    unchecked:
                        return Ok(from_i64(-*n))
            case _:
                pass
        Ok(canonical(not self.is_negative(), words(self)?))

    pub def __sub__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a - *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        if self.is_negative() != other.is_negative():
            return Ok(canonical(self.is_negative(), magnitude_add(self, other)?))
        order = magnitude_cmp(self, other)
        if order == 0:
            return Ok(from_i64(0))
        if order > 0:
            Ok(canonical(self.is_negative(), magnitude_sub(self, other)?))
        else:
            Ok(canonical(not self.is_negative(), magnitude_sub(other, self)?))

    pub def __mul__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if self.is_zero() or other.is_zero():
            return Ok(from_i64(0))
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a * *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        a = words(self)?
        b = words(other)?
        Ok(canonical(self.is_negative() != other.is_negative(), multiply(&a, &b)?))

    pub def add_assign(self: &mut BigInt, other: &BigInt) -> Result[(), AllocError]:
        result = (self + other)?
        self._value = result._value
        Ok(())

    pub def __floordiv__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if other.is_zero():
            __trap("BigInt.__floordiv__: divisor is zero")
        pair = quotient_remainder(self, other)?
        (q, _) = pair
        Ok(q)

    pub def __mod__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if other.is_zero():
            __trap("BigInt.__mod__: divisor is zero")
        pair = quotient_remainder(self, other)?
        (_, r) = pair
        Ok(r)

    pub def checked_divmod(self, other: &BigInt) -> Result[(BigInt, BigInt), BigIntError]:
        if other.is_zero():
            return Err(BigIntError.ZeroDivision)
        quotient_remainder(self, other).map_error(BigIntError.Allocation)

    pub def __lshift__(self, count: i64) -> Result[BigInt, AllocError]:
        if count < 0:
            __trap("BigInt.__lshift__: count is negative")
        if self.is_zero():
            return Ok(from_i64(0))
        match &self._value:
            case Value.Small(n):
                if count < 63:
                    factor = unchecked:
                        1i64 << count
                    result = checked:
                        *n * factor
                    match result:
                        case Ok(value):
                            return Ok(from_i64(value))
                        case Err(_):
                            pass
                elif count == 63 and *n == -1:
                    return Ok(from_i64(i64.MIN))
            case _:
                pass
        unchecked:
            extra = count // 64
            if extra > i64.MAX - self.word_len() - 1:
                return Err(AllocError.CapacityOverflow)
            mut result = zeros(self.word_len() + extra + 1)?
            shift = u64(count % 64)
            for i in range(self.word_len()):
                value = self.word(i)
                result[i + extra] = result[i + extra] | (value << shift)
                if shift != 0u64:
                    result[i + extra + 1] = value >> (64u64 - shift)
            Ok(canonical(self.is_negative(), result))

    pub def __rshift__(self, count: i64) -> Result[BigInt, AllocError]:
        if count < 0:
            __trap("BigInt.__rshift__: count is negative")
        match &self._value:
            case Value.Small(n):
                if count >= 63:
                    return Ok(from_i64(-1 if *n < 0 else 0))
                unchecked:
                    return Ok(from_i64(*n >> count))
            case _:
                pass
        unchecked:
            extra = count // 64
            if extra >= self.word_len():
                return Ok(from_i64(-1 if self.is_negative() else 0))
            shift = u64(count % 64)
            mut result = zeros(self.word_len() - extra)?
            mut discarded = False
            for i in range(extra):
                discarded = discarded or self.word(i) != 0u64
            if shift != 0u64:
                discarded = discarded or (self.word(extra) << (64u64 - shift)) != 0u64
            for i in range(len(result)):
                result[i] = self.word(i + extra) >> shift
                if shift != 0u64:
                    result[i] = result[i] | (self.word(i + extra + 1) << (64u64 - shift))
            value = canonical(self.is_negative(), result)
            if self.is_negative() and discarded:
                return value - from_i64(1)
            Ok(value)

    pub def __and__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 0)

    pub def __or__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 1)

    pub def __xor__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 2)

    pub def to_string(self, radix: i64 = 10, max_digits: NonNegative[i64] = 10000) -> Result[str, BigIntError]:
        if radix < 2 or radix > 36:
            return Err(BigIntError.InvalidRadix)
        if self.word_len() <= 1:
            return render_one_word(self, radix, max_digits.get())
        render_large(self, radix, max_digits.get())

    pub def display[W](self, out: &mut Formatter[W]) -> Result[(), FormatError]:
        match self.to_string():
            case Ok(text):
                out.text(text)
            case Err(BigIntError.Allocation(cause)):
                Err(FormatError.Allocation(cause))
            case Err(_):
                Err(FormatError.LimitExceeded)

pub def from_i64(value: i64) -> BigInt:
    BigInt(Value.Small(value))

pub def from_u64(value: u64) -> Result[BigInt, AllocError]:
    signed_word(False, value)

pub def parse(text: &strview, radix: i64 = 10, max_digits: NonNegative[i64] = 10000) -> Result[BigInt, BigIntError]:
    if radix < 2 or radix > 36:
        return Err(BigIntError.InvalidRadix)
    data = text.as_bytes()
    if len(data) == 0:
        return Err(BigIntError.InvalidDigit)
    negative = data[0] == 45u8
    start = 1 if negative or data[0] == 43u8 else 0
    unchecked:
        if len(data) - start > max_digits.get():
            return Err(BigIntError.LimitExceeded)
        if start == len(data):
            return Err(BigIntError.InvalidDigit)
        if radix <= 10:
            for byte in &data[start:]:
                if byte.wrapping_sub(48u8) >= u8(radix):
                    return Err(BigIntError.InvalidDigit)
        else:
            for byte in &data[start:]:
                digit = digit_value(*byte)
                if digit < 0 or digit >= radix:
                    return Err(BigIntError.InvalidDigit)
        mut first = start
        while first < len(data) and data[first] == 48u8:
            first += 1
        digits = &data[first:]
        if len(digits) <= 12:
            word = i64(parse_word(digits, u64(radix)))
            return Ok(from_i64(-word if negative else word))
        if radix & (radix - 1) == 0:
            return parse_power_of_two(digits, u64(radix), negative).map_error(BigIntError.Allocation)
        (width, factor) = radix_group(u64(radix))
        if len(digits) <= width:
            return signed_word(negative, parse_word(digits, u64(radix))).map_error(BigIntError.Allocation)
        mut powers = RadixPowers(radix, dict[i64, BigInt]().map_error(BigIntError.Allocation)?, Nothing)
        limbs = parse_digits(digits, len(digits) // 2, u64(radix), width, factor, &mut powers).map_error(BigIntError.Allocation)?
        Ok(canonical(negative, limbs))

def digit_value(ch: u8) -> i64:
    unchecked:
        if ch >= 48u8 and ch <= 57u8:
            i64(ch - 48u8)
        elif ch >= 65u8 and ch <= 90u8:
            i64(ch - 65u8) + 10
        elif ch >= 97u8 and ch <= 122u8:
            i64(ch - 97u8) + 10
        else:
            -1

# Compute each exact power from its halved exponent. Normalized
# divisors and their optional reciprocals belong to one conversion.
class RadixPowers:
    radix: i64
    exact: dict[i64, BigInt]
    prepared: Option[dict[i64, WideDivisor]]

    def power(self: &mut RadixPowers, exponent: i64) -> Result[&BigInt, AllocError]:
        if exponent not in self.exact:
            self.compute(exponent)?
        Ok(self.exact.get_ref(exponent).unwrap())

    def divide(self: &mut RadixPowers, value: &BigInt, exponent: i64, reuse: bool) -> Result[(list[u64], list[u64]), AllocError]:
        if exponent not in self.exact:
            self.compute(exponent)?
        power = self.exact.get_ref(exponent).unwrap()
        if power.word_len() < WIDE_DIVISION_LIMBS or magnitude_cmp(value, power) < 0:
            return divide_narrow(value, power)
        if self.prepared.is_none():
            self.prepared = Some(dict[i64, WideDivisor]()?)
        match &mut self.prepared:
            case Some(divisors):
                if exponent not in divisors:
                    divisors.insert(exponent, prepare_wide_divisor(power)?)?
                divisor = divisors.get_mut(exponent).unwrap()
                if reuse:
                    divisor.prepare_radix_reciprocal(value.word_len())?
                divide_wide(value, divisor, RADIX_DIVISION_BLOCK_LIMBS)
            case Nothing:
                __trap("std.bigint: missing prepared divisor cache")

    def compute(self: &mut RadixPowers, exponent: i64) -> Result[(), AllocError]:
        unchecked:
            if exponent <= 1:
                self.exact.insert(exponent, from_i64(1 if exponent == 0 else self.radix))?
                return Ok(())
            radix = self.radix
            odd = exponent % 2 != 0
            half = self.power(exponent // 2)?
            result = match &half._value:
                case Value.Small(_):
                    square = (half * half)?
                    if odd:
                        (square * from_i64(radix))?
                    else:
                        square
                case Value.Large(_, limbs):
                    extend_radix_power(&limbs, u64(radix), odd)?
            self.exact.insert(exponent, result)?
            Ok(())

# A power is squared at each step and multiplied by one more radix
# when the exponent is odd. Whole low zero limbs give an exact shift.
def extend_radix_power(limbs: &[u64], radix: u64, odd: bool) -> Result[BigInt, AllocError]:
    unchecked:
        low = first_nonzero_word(limbs)
        width = 2 * len(limbs)
        mut out = zeros(width + (1 if odd else 0))?
        used = &limbs[low:]
        product = &mut out[2 * low:width]
        if use_transform(len(used), len(used)):
            multiply_transform_wide_into(used, used, product, square=True)?
        else:
            multiply_into(used, used, product)?
        if odd:
            carry = multiply_word_add(product, radix, 0u64)
            out[width] = carry
        Ok(canonical(False, out))

def first_nonzero_word(limbs: &[u64]) -> i64:
    unchecked:
        mut i = 0
        while limbs[i] == 0u64:
            i += 1
        i

# Every digit was validated before parsing. The caller gives a range
# whose magnitude fits a word, including an empty range for zero.
def parse_word(data: &[u8], radix: u64) -> u64:
    unchecked:
        mut value = 0u64
        if radix == 10u64:
            for byte in data:
                value = value * 10u64 + u64(*byte - 48u8)
        else:
            for byte in data:
                value = value * radix + decoded_digit(*byte)
        value

# For validated ASCII, the low five bits give 16..25 for numbers and
# 1..26 for letters. Bit six is set only for letters of either case.
def decoded_digit(byte: u8) -> u64:
    unchecked:
        u64(byte & 31u8) + 25u64 * u64(byte >> 6u8) - 16u64

def signed_word(negative: bool, word: u64) -> Result[BigInt, AllocError]:
    unchecked:
        if word <= 9223372036854775807u64:
            return Ok(from_i64(-i64(word) if negative else i64(word)))
        if negative and word == 9223372036854775808u64:
            return Ok(from_i64(i64.MIN))
        Ok(BigInt(Value.Large(negative, [word]?)))

def radix_bit_width(radix: u64) -> i64:
    unchecked:
        mut bits = 0
        mut value = radix
        while value > 1u64:
            value >>= 1u64
            bits += 1
        bits

def parse_power_of_two(data: &[u8], radix: u64, negative: bool) -> Result[BigInt, AllocError]:
    unchecked:
        bits = radix_bit_width(radix)
        if len(data) <= 64 // bits:
            return signed_word(negative, parse_word(data, radix))
        # Compute ceil(len(data) * bits / 64) without multiplying the full length.
        count = len(data) // 64 * bits + (len(data) % 64 * bits + 63) // 64
        mut limbs = zeros(count)?
        mut word = 0u64
        mut index = 0
        mut shift = 0
        mut i = len(data)
        while i > 0:
            i -= 1
            digit = decoded_digit(data[i])
            word |= digit << u64(shift)
            shift += bits
            if shift >= 64:
                limbs[index] = word
                index += 1
                shift -= 64
                word = digit >> u64(bits - shift)
        if shift != 0:
            limbs[index] = word
        Ok(canonical(negative, limbs))

const PARSE_LEAF_GROUPS: i64 = 112

def parse_digits(data: &[u8], split: i64, radix: u64, width: i64, factor: u64, powers: &mut RadixPowers) -> Result[list[u64], AllocError]:
    unchecked:
        if len(data) <= PARSE_LEAF_GROUPS * width:
            return parse_leaf(data, radix, width, factor)
        # The right-hand width is shared across each depth. The left
        # child absorbs the extra digit whenever the width is odd.
        middle = len(data) - split
        left = parse_digits(&data[:middle], split // 2, radix, width, factor, &mut powers)?
        right = parse_digits(&data[middle:], split // 2, radix, width, factor, &mut powers)?
        if len(left) == 0:
            return Ok(right)
        power = powers.power(split)?
        match &power._value:
            case Value.Large(_, scale):
                combine_parse_words(&left, &right, &scale)
            case Value.Small(_):
                scale = [power.word(0)]?
                combine_parse_words(&left, &right, &scale)

def combine_parse_words(left: &[u64], right: &[u64], scale: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        mut shift = first_nonzero_word(scale)
        # Stripping zero limbs from even radix powers is useful unless
        # doing so would send a balanced product to schoolbook.
        if len(scale) - shift < (len(left) + 1) // 2:
            shift = 0
        mut result = zeros(len(left) + len(scale))?
        multiply_into(left, &scale[shift:], &mut result[shift:])?
        add_shifted(&mut result, right, 0)
        trim(&mut result)
        Ok(result)

def parse_leaf(data: &[u8], radix: u64, width: i64, factor: u64) -> Result[list[u64], AllocError]:
    unchecked:
        first = (len(data) - 1) % width + 1
        mut limbs = zeros((len(data) - 1) // width + 1)?
        head = parse_word(&data[:first], radix)
        limbs[0] = head
        mut used = 0 if head == 0u64 else 1
        mut end = first
        while end < len(data):
            next = end + width
            chunk = parse_word(&data[end:next], radix)
            carry = multiply_word_add(&mut limbs[:used], factor, chunk)
            if carry != 0u64:
                limbs[used] = carry
                used += 1
            end = next
        trim(&mut limbs)
        Ok(limbs)

# With B = 2^64, (B-1)^2 + (B-1) < B^2.
def multiply_word_add(limbs: &mut [u64], factor: u64, addend: u64) -> u64:
    unchecked:
        mut carry = addend
        for i in range(len(limbs)):
            (low, high) = limbs[i].widening_mul(factor)
            sum = low.wrapping_add(carry)
            limbs[i] = sum
            carry = high + borrow_bit(sum, low, carry)
        carry

# Return the greatest radix power that fits in a limb and its digit width.
def radix_group(radix: u64) -> (i64, u64):
    unchecked:
        limit = u64.MAX // radix
        mut factor = radix
        mut width = 1
        while factor <= limit:
            factor *= radix
            width += 1
        (width, factor)

# A word-sized radix power lets short division extract a full group of
# digits at a time. Normalize the divisor and invert it once per render.
@copy
class RadixChunk:
    width: i64
    log_floor: i64
    shift: u64
    divisor: u64
    inverse: u64

def radix_chunk(radix: u64) -> RadixChunk:
    unchecked:
        (width, divisor) = radix_group(radix)
        mut bits = 0
        mut high = divisor
        while high > 1u64:
            high >>= 1u64
            bits += 1
        shift = u64(63 - bits)
        normalized = divisor << shift
        RadixChunk(width, bits, shift, normalized, inverse_division_word(normalized))

def render_one_word(value: &BigInt, radix: i64, limit: i64) -> Result[str, BigIntError]:
    unchecked:
        word = value.word(0)
        mut count = word
        mut width = 1
        while count >= u64(radix):
            count //= u64(radix)
            width += 1
        if width > limit:
            return Err(BigIntError.LimitExceeded)
        sign = 1 if value.is_negative() else 0
        mut digits = [0u8 for _ in range(width + sign)].map_error(BigIntError.Allocation)?
        render_word(word, u64(radix), &mut digits[sign:])
        if sign != 0:
            digits[0] = 45u8
        render_text(&digits)

def render_text(digits: &[u8]) -> Result[str, BigIntError]:
    match to_text(digits):
        case Ok(text):
            Ok(text)
        case Err(BytesError.Allocation(cause)):
            Err(BigIntError.Allocation(cause))
        case Err(_):
            __trap("std.bigint: render produced non-ASCII digits")

def render_large(value: &BigInt, radix: i64, limit: i64) -> Result[str, BigIntError]:
    unchecked:
        bits = value.bit_length()
        if radix & (radix - 1) == 0:
            return render_power_of_two(value, u64(radix), bits, limit)
        chunk = radix_chunk(u64(radix))
        # 2^log_floor <= radix^chunk.width < 2^(log_floor + 1).
        # Split the products into quotient and remainder to avoid overflow.
        low_bits = bits - 1
        ceil_log = chunk.log_floor + 1
        lower_whole = (low_bits // ceil_log) * chunk.width
        lower_fraction = ((low_bits % ceil_log) * chunk.width) // ceil_log
        if limit < lower_whole + lower_fraction + 1:
            return Err(BigIntError.LimitExceeded)
        upper_whole = (bits // chunk.log_floor) * chunk.width
        upper_fraction = ((bits % chunk.log_floor) * chunk.width + chunk.log_floor - 1) // chunk.log_floor
        upper = upper_whole + upper_fraction
        mut powers = RadixPowers(radix, dict[i64, BigInt]().map_error(BigIntError.Allocation)?, Nothing)
        if limit < upper:
            powers.compute(limit).map_error(BigIntError.Allocation)?
            boundary = powers.exact.get_ref(limit).unwrap()
            if magnitude_cmp(value, boundary) >= 0:
                return Err(BigIntError.LimitExceeded)
        width = limit if limit < upper else upper
        if width == i64.MAX:
            return Err(BigIntError.Allocation(AllocError.CapacityOverflow))
        # Reserve a byte for an optional minus sign immediately before the
        # first significant digit, including when there is no leading padding.
        mut digits = [0u8 for _ in range(width + 1)].map_error(BigIntError.Allocation)?
        render_digits(value, u64(radix), chunk, &mut digits[1:], width // 2, False, &mut powers).map_error(BigIntError.Allocation)?
        # The magnitude is nonzero, so a significant digit ends this scan.
        mut first = 1
        while digits[first] == 48u8:
            first += 1
        if value.is_negative():
            first -= 1
            digits[first] = 45u8
        render_text(&digits[first:])

def render_power_of_two(value: &BigInt, radix: u64, bits: i64, limit: i64) -> Result[str, BigIntError]:
    unchecked:
        group = radix_bit_width(radix)
        width = (bits - 1) // group + 1
        if width > limit:
            return Err(BigIntError.LimitExceeded)
        sign = 1 if value.is_negative() else 0
        if width == i64.MAX and sign != 0:
            return Err(BigIntError.Allocation(AllocError.CapacityOverflow))
        mut digits = [0u8 for _ in range(width + sign)].map_error(BigIntError.Allocation)?
        alphabet = b"0123456789abcdefghijklmnopqrstuvwxyz"
        for i in range(width):
            position = (width - 1 - i) * group
            word = position // 64
            shift = position % 64
            mut digit = value.word(word) >> u64(shift)
            if shift + group > 64:
                digit |= value.word(word + 1) << u64(64 - shift)
            digits[sign + i] = alphabet[i64(digit & (radix - 1u64))]
        if sign != 0:
            digits[0] = 45u8
        render_text(&digits)

def render_word(value: u64, radix: u64, output: &mut [u8]) -> ():
    unchecked:
        mut n = value
        alphabet = b"0123456789abcdefghijklmnopqrstuvwxyz"
        mut i = len(output)
        while i > 0:
            i -= 1
            q = n // radix
            # q * radix <= n. Form the remainder from the quotient.
            digit = n.wrapping_sub(q.wrapping_mul(radix))
            output[i] = alphabet[i64(digit)]
            n = q


def render_chunks(value: &BigInt, radix: u64, chunk: RadixChunk, output: &mut [u8]) -> Result[(), AllocError]:
    unchecked:
        mut scratch = words(value)?
        mut size = len(scratch)
        mut end = len(output)
        while size > 1:
            remainder = divide_render_chunk(&mut scratch[:size], chunk)
            end -= chunk.width
            render_word(remainder, radix, &mut output[end:end + chunk.width])
            if scratch[size - 1] == 0u64:
                size -= 1
        render_word(scratch[0], radix, &mut output[:end])
        Ok(())

def divide_render_chunk(words: &mut [u64], chunk: RadixChunk) -> u64:
    unchecked:
        shift = chunk.shift
        # Keep the carried remainder normalized. Its low shift bits are
        # zero because the normalized dividend and divisor share that factor.
        mut remainder = 0u64
        mut i = len(words)
        while i > 0:
            i -= 1
            word = words[i]
            hi = remainder | (0u64 if shift == 0u64 else word >> (64u64 - shift))
            (quotient, rest) = estimate_division_word(hi, word << shift, chunk.divisor, chunk.inverse)
            words[i] = quotient
            remainder = rest
        remainder >> shift

def render_digits(value: &BigInt, radix: u64, chunk: RadixChunk, output: &mut [u8], split: i64, reuse: bool, powers: &mut RadixPowers) -> Result[(), AllocError]:
    unchecked:
        if value.word_len() <= 1:
            render_word(value.word(0), radix, output)
            return Ok(())
        if value.word_len() <= 96:
            return render_chunks(value, radix, chunk, output)
        # Use the same right-hand width at each depth so sibling splits
        # share one power and reciprocal even when the widths are odd.
        middle = len(output) - split
        (q, r) = powers.divide(value, split, reuse)?
        left = canonical(False, q)
        right = canonical(False, r)
        render_digits(&left, radix, chunk, &mut output[:middle], split // 2, True, &mut powers)?
        render_digits(&right, radix, chunk, &mut output[middle:], split // 2, True, &mut powers)?
        Ok(())

# Normalize an owned magnitude. Zero has no sign and each value in the signed
# word range returns to the inline representation.
def canonical(negative: bool, source: list[u64]) -> BigInt:
    mut value = source
    trim(&mut value)
    if len(value) == 0:
        return from_i64(0)
    if len(value) == 1:
        limit = 9223372036854775808u64 if negative else 9223372036854775807u64
        if value[0] <= limit:
            unchecked:
                if negative and value[0] == 9223372036854775808u64:
                    return from_i64(i64.MIN)
                n = -i64(value[0]) if negative else i64(value[0])
                return from_i64(n)
    BigInt(Value.Large(negative, value))

def trim(value: &mut list[u64]) -> ():
    while len(value) > 0:
        if value[-1] != 0u64:
            return
        drop(value.pop())

def zeros(length: i64) -> Result[list[u64], AllocError]:
    [0u64 for _ in range(length)]

def words(value: &BigInt) -> Result[list[u64], AllocError]:
    mut result = list[u64].with_capacity(value.word_len())?
    for i in range(value.word_len()):
        result.append(value.word(i))?
    Ok(result)

def magnitude_cmp(a: &BigInt, b: &BigInt) -> i64:
    if a.word_len() != b.word_len():
        return -1 if a.word_len() < b.word_len() else 1
    unchecked:
        mut i = a.word_len()
        while i > 0:
            i -= 1
            if a.word(i) != b.word(i):
                return -1 if a.word(i) < b.word(i) else 1
    0

def magnitude_add(a: &BigInt, b: &BigInt) -> Result[list[u64], AllocError]:
    unchecked:
        n = a.word_len() if a.word_len() > b.word_len() else b.word_len()
        mut result = list[u64].with_capacity(n + 1)?
        mut carry = False
        for i in range(n):
            (word, overflow) = a.word(i).carrying_add(b.word(i), carry)
            result.append(word)?
            carry = overflow
        if carry:
            result.append(1u64)?
        Ok(result)

def magnitude_sub(a: &BigInt, b: &BigInt) -> Result[list[u64], AllocError]:
    mut result = list[u64].with_capacity(a.word_len())?
    mut borrow = False
    for i in range(a.word_len()):
        x = a.word(i)
        y = b.word(i)
        difference = x.wrapping_sub(y)
        result.append(difference.wrapping_sub(1u64 if borrow else 0u64))?
        borrow = x < y or (borrow and difference == 0u64)
    Ok(result)

# Borrow limbs directly through recursion. The result has enough room for
# every partial product; the final public constructor trims leading zeroes.
def add_words(a: &[u64], b: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        n = len(a) if len(a) > len(b) else len(b)
        mut out = zeros(n + 1)?
        add_words_into(a, b, &mut out)
        trim(&mut out)
        Ok(out)

def add_words_into(a: &[u64], b: &[u64], out: &mut [u64]) -> ():
    unchecked:
        mut carry = False
        n = len(out) - 1
        for i in range(n):
            x = a[i] if i < len(a) else 0u64
            y = b[i] if i < len(b) else 0u64
            (word, overflow) = x.carrying_add(y, carry)
            out[i] = word
            carry = overflow
        out[n] = 1u64 if carry else 0u64

def subtract_words(out: &mut [u64], b: &[u64]) -> ():
    mut borrow = False
    for i in range(len(out)):
        x = out[i]
        y = b[i] if i < len(b) else 0u64
        difference = x.wrapping_sub(y)
        out[i] = difference.wrapping_sub(1u64 if borrow else 0u64)
        borrow = x < y or (borrow and difference == 0u64)

def add_shifted(out: &mut [u64], value: &[u64], offset: i64) -> ():
    unchecked:
        mut carry = False
        for i in range(len(value)):
            (word, overflow) = out[offset + i].carrying_add(value[i], carry)
            out[offset + i] = word
            carry = overflow
        mut position = offset + len(value)
        while carry:
            (word, overflow) = out[position].carrying_add(0u64, carry)
            out[position] = word
            carry = overflow
            position += 1

def multiply(a: &[u64], b: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = zeros(len(a) + len(b))?
        shorter = len(a) if len(a) < len(b) else len(b)
        if shorter < 32 or (shorter < TRANSFORM_MIN_LIMBS and len(out) > 3 * shorter):
            multiply_schoolbook(a, b, &mut out)
        else:
            multiply_into(a, b, &mut out)?
        Ok(out)

# Output regions start zeroed and cannot resize. The low and high recursive
# products occupy disjoint final regions; interpolation reads them before
# adding the middle coefficients, eliminating two owning arrays per node.
def multiply_into(a: &[u64], b: &[u64], out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        if use_transform(len(a), len(b)):
            return multiply_transform_wide_into(a, b, out)
        n = len(a) if len(a) > len(b) else len(b)
        third = (n + 2) // 3
        shorter = len(a) if len(a) < len(b) else len(b)
        if use_skewed_product(n, shorter):
            if len(a) > len(b):
                return multiply_skewed_into(a, b, out)
            return multiply_skewed_into(b, a, out)
        if n >= 128 and len(a) > 2 * third and len(b) > 2 * third and 4 * n <= 5 * shorter:
            return multiply_toom3_into(a, b, third, out)
        if len(a) >= 32 and len(b) >= 32 and len(a) <= 2 * len(b) and len(b) <= 2 * len(a):
            half = n // 2
            middle_start = half * 2
            multiply_into(&a[:half], &b[:half], &mut out[:middle_start])?
            multiply_into(&a[half:], &b[half:], &mut out[middle_start:])?
            sum_a = add_words(&a[:half], &a[half:])?
            sum_b = add_words(&b[:half], &b[half:])?
            mut middle = multiply(&sum_a, &sum_b)?
            subtract_words(&mut middle, &out[:middle_start])
            subtract_words(&mut middle, &out[middle_start:])
            trim(&mut middle)
            add_shifted(out, &middle, half)
        else:
            multiply_schoolbook(a, b, out)
        Ok(())

# Full blocks share the short operand's transform and the roots for each
# prime. One set of inverse rows serves every block, independent of the
# longer operand's length. Only the final short tail uses normal dispatch.
def multiply_skewed_into(longer: &[u64], shorter: &[u64], out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        width = len(shorter)
        n = transform_length(width)
        plan0 = prepare_transform(shorter, n, width, transform_prime_0())?
        plan1 = prepare_transform(shorter, n, width, transform_prime_1())?
        plan2 = prepare_transform(shorter, n, width, transform_prime_2())?
        plan3 = prepare_transform(shorter, n, width, transform_prime_3())?
        plan4 = prepare_transform(shorter, n, width, transform_prime_4())?
        mut row0 = zeros(n)?
        mut row1 = zeros(n)?
        mut row2 = zeros(n)?
        mut row3 = zeros(n)?
        mut row4 = zeros(n)?
        mut scratch = zeros(2 * width)?
        mut start = 0
        while start <= len(longer) - width:
            block = &longer[start:start + width]
            plan0.multiply(block, &mut row0)
            plan1.multiply(block, &mut row1)
            plan2.multiply(block, &mut row2)
            plan3.multiply(block, &mut row3)
            plan4.multiply(block, &mut row4)
            drop(transform_wide_recover(&row0, &row1, &row2, &row3, &row4, &mut scratch))
            add_shifted(out, &scratch, start)
            start += width
        if start < len(longer):
            tail = &longer[start:]
            product = &mut scratch[:width + len(tail)]
            clear_words(product)
            multiply_into(tail, shorter, product)?
            add_shifted(out, product, start)
        Ok(())

# Toom-3 evaluates the limb polynomials at 0, 1, -1, 2 and infinity.
# Signed evaluation is represented only by a magnitude and one sign bit;
# interpolation coefficients are nonnegative. No public BigInt temporaries
# or copying operand slices are needed in this recursion.
def multiply_toom3_into(a: &[u64], b: &[u64], k: i64, out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        a0 = &a[:k]
        a1 = &a[k:2 * k]
        a2 = &a[2 * k:]
        b0 = &b[:k]
        b1 = &b[k:2 * k]
        b2 = &b[2 * k:]
        low_end = 2 * k
        high_start = 4 * k
        multiply_into(a0, b0, &mut out[:low_end])?
        multiply_into(a2, b2, &mut out[high_start:])?
        a_sum = add_words(a0, a2)?
        b_sum = add_words(b0, b2)?
        a_one = add_words(&a_sum, a1)?
        b_one = add_words(&b_sum, b1)?
        mut v1 = multiply(&a_one, &b_one)?
        (a_negative, a_minus) = absolute_difference(&a_sum, a1)?
        (b_negative, b_minus) = absolute_difference(&b_sum, b1)?
        vm = multiply(&a_minus, &b_minus)?
        mut odd = zeros(len(v1) + 1)?
        if a_negative != b_negative:
            add_words_into(&v1, &vm, &mut odd)
        else:
            copy_words(&v1, &mut odd[:len(v1)])
            subtract_words(&mut odd, &vm)
        divide_words_two(&mut odd)
        trim(&mut odd)
        subtract_words(&mut v1, &out[:low_end])
        subtract_words(&mut v1, &out[high_start:])
        subtract_words(&mut v1, &odd)
        trim(&mut v1)
        a_two = evaluate_two(a0, a1, a2)?
        b_two = evaluate_two(b0, b1, b2)?
        mut cubic = multiply(&a_two, &b_two)?
        subtract_words(&mut cubic, &out[:low_end])
        subtract_scaled(&mut cubic, &out[high_start:], 16u64)
        divide_words_two(&mut cubic)
        subtract_words(&mut cubic, &odd)
        subtract_scaled(&mut cubic, &v1, 2u64)
        divide_words_three(&mut cubic)
        trim(&mut cubic)
        subtract_words(&mut odd, &cubic)
        trim(&mut odd)
        add_shifted(out, &odd, k)
        add_shifted(out, &v1, 2 * k)
        add_shifted(out, &cubic, 3 * k)
        Ok(())

def absolute_difference(a: &[u64], b: &[u64]) -> Result[(bool, list[u64]), AllocError]:
    unchecked:
        mut an = len(a)
        mut bn = len(b)
        while an > 0 and a[an - 1] == 0u64:
            an -= 1
        while bn > 0 and b[bn - 1] == 0u64:
            bn -= 1
        mut negative = an < bn
        if an == bn:
            mut i = an
            while i > 0:
                i -= 1
                if a[i] != b[i]:
                    negative = a[i] < b[i]
                    break
        mut out = zeros(an if an > bn else bn)?
        if negative:
            copy_words(&b[:bn], &mut out[:bn])
            subtract_words(&mut out, &a[:an])
        else:
            copy_words(&a[:an], &mut out[:an])
            subtract_words(&mut out, &b[:bn])
        trim(&mut out)
        Ok((negative, out))

def evaluate_two(a: &[u64], b: &[u64], c: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = zeros(len(a) + 1)?
        mut carry = 0u64
        for i in range(len(a)):
            x = b[i]
            y = c[i] if i < len(c) else 0u64
            (first, c1) = a[i].carrying_add(x << 1u64, False)
            (second, c2) = first.carrying_add(y << 2u64, False)
            (word, c3) = second.carrying_add(carry, False)
            out[i] = word
            carry = (x >> 63u64) + (y >> 62u64) + (1u64 if c1 else 0u64) + (1u64 if c2 else 0u64) + (1u64 if c3 else 0u64)
        out[len(a)] = carry
        trim(&mut out)
        Ok(out)

# Subtract a small multiple without constructing another limb array.
def subtract_scaled(out: &mut [u64], value: &[u64], factor: u64) -> ():
    unchecked:
        mut carry = 0u64
        mut borrow = False
        for i in range(len(out)):
            x = value[i] if i < len(value) else 0u64
            (low, high) = x.widening_mul(factor)
            (scaled, overflow) = low.carrying_add(carry, False)
            carry = high + (1u64 if overflow else 0u64)
            old = out[i]
            difference = old.wrapping_sub(scaled)
            out[i] = difference.wrapping_sub(1u64 if borrow else 0u64)
            borrow = old < scaled or (borrow and difference == 0u64)

def divide_words_two(value: &mut [u64]) -> ():
    unchecked:
        mut carry = 0u64
        mut i = len(value)
        while i > 0:
            i -= 1
            word = value[i]
            value[i] = (word >> 1u64) | carry
            carry = word << 63u64

# Each interpolation numerator is exactly divisible. Base-2^32 long
# division keeps the two-digit dividend inside a u64 on every step.
def divide_words_three(value: &mut [u64]) -> ():
    unchecked:
        mut remainder = 0u64
        mut i = len(value)
        while i > 0:
            i -= 1
            word = value[i]
            high = (remainder << 32u64) | (word >> 32u64)
            low = ((high % 3u64) << 32u64) | (word & 4294967295u64)
            value[i] = ((high // 3u64) << 32u64) | (low // 3u64)
            remainder = low % 3u64

# The retained capacity bound is within all five prime root orders.
# Linear products truncate the work on padded transform slots.
const TRANSFORM_MIN_LIMBS: i64 = 1024
const MAX_TRANSFORM_WORDS: i64 = 524288

def use_transform(a: i64, b: i64) -> bool:
    if a < TRANSFORM_MIN_LIMBS or b < TRANSFORM_MIN_LIMBS or a > MAX_TRANSFORM_WORDS or b > MAX_TRANSFORM_WORDS:
        return False
    unchecked:
        a <= 2 * b and b <= 2 * a and a + b <= MAX_TRANSFORM_WORDS

def transform_length(digits: i64) -> i64:
    unchecked:
        mut n = 1
        while n < digits:
            n *= 2
        n

def use_skewed_product(longer: i64, shorter: i64) -> bool:
    unchecked:
        use_transform(shorter, shorter) and longer > 2 * shorter

def copy_words(source: &[u64], out: &mut [u64]) -> ():
    for i in range(len(out)):
        out[i] = source[i]

@copy
class TransformPrime:
    p: u64
    generator: u64
    inverse: u64
    r: u64
    r2: u64
    r3: u64

def transform_prime_0() -> TransformPrime:
    TransformPrime(1152779667606863873u64, 3u64, 1152779667606863871u64, 2269391999729648u64, 438850205479958496u64, 577409928151867344u64)

def transform_prime_1() -> TransformPrime:
    TransformPrime(1152702701792919553u64, 5u64, 1152702701792919551u64, 3500845022838768u64, 549807853720474145u64, 836242407834260066u64)

def transform_prime_2() -> TransformPrime:
    TransformPrime(1152654323281297409u64, 3u64, 1152654323281297407u64, 4274901208793072u64, 1065844120376875002u64, 870989715713157113u64)

def transform_prime_3() -> TransformPrime:
    TransformPrime(1152647726211530753u64, 3u64, 1152647726211530751u64, 4380454325059568u64, 726084339089016087u64, 915534325496093643u64)

def transform_prime_4() -> TransformPrime:
    TransformPrime(1152577357467353089u64, 7u64, 1152577357467353087u64, 5506354231902192u64, 1052221714738828282u64, 443901272462896093u64)

# Wide exact transforms pack two u64 limbs per digit. Five independently
# generated Proth primes provide >299 coefficient bits; the common root
# order exceeds the retained transform limit. Constants and certificates are
# regenerated by experiments/bigint-comparison/algorithms-next/constants.py.
# Linear products use van der Hoeven's truncated Fourier transform over
# the same prime fields. The number of slots to recover includes the last
# pair of output limbs, even if it contains only carried value.
# A cyclic product wraps at the power-of-two output length. Each packed
# coefficient still has at most one term per point, so the CRT bound holds.
def multiply_transform_wide_into(a: &[u64], b: &[u64], out: &mut [u64], cyclic: bool = False, square: bool = False) -> Result[(), AllocError]:
    unchecked:
        digits = len(out) // 2 if cyclic else (len(out) + 1) // 2
        n = transform_length(digits)
        mut x = zeros(n)?
        mut y = zeros(0 if square else n)?
        mut roots = zeros(n // 2)?
        mut residues0 = zeros(digits)?
        mut residues1 = zeros(digits)?
        mut residues2 = zeros(digits)?
        mut residues3 = zeros(digits)?
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, digits, transform_prime_0(), square)
        copy_words(&x, &mut residues0)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, digits, transform_prime_1(), square)
        copy_words(&x, &mut residues1)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, digits, transform_prime_2(), square)
        copy_words(&x, &mut residues2)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, digits, transform_prime_3(), square)
        copy_words(&x, &mut residues3)
        transform_wide_product(a, b, &mut x, &mut y, &mut roots, digits, transform_prime_4(), square)
        (c0, c1, c2) = transform_wide_recover(&residues0, &residues1, &residues2, &residues3, &x, out)
        if cyclic:
            # B^len(out) is congruent to one. Fold the carry back into
            # the low words and propagate an end-around carry if needed.
            (w0, b0) = out[0].carrying_add(c0, False)
            (w1, b1) = out[1].carrying_add(c1, b0)
            (w2, b2) = out[2].carrying_add(c2, b1)
            out[0] = w0
            out[1] = w1
            out[2] = w2
            if b2 and increment_words(&mut out[3:]):
                drop(increment_words(out))
        Ok(())

# For a word below 2p, the high bit of word-p marks unsigned underflow.
def reduce_transform_word(word: u64, p: u64) -> u64:
    reduced = word.wrapping_sub(p)
    reduced.wrapping_add(p & 0u64.wrapping_sub(reduced >> 63u64))

# REDC with R=2^64. The caller supplies high<p, so T<p*R and the
# unreduced result is below 2p < 2^61. The low words cancel modulo R
# and their addition carries precisely when low is nonzero.
def transform_wide_reduce(low: u64, high: u64, p: u64, inverse: u64) -> u64:
    unchecked:
        m = low.wrapping_mul(inverse)
        (_, m_high) = m.widening_mul(p)
        carry = (low | 0u64.wrapping_sub(low)) >> 63u64
        reduce_transform_word(high + m_high + carry, p)

def transform_wide_multiply(a: u64, b: u64, p: u64, inverse: u64) -> u64:
    (low, high) = a.widening_mul(b)
    transform_wide_reduce(low, high, p, inverse)

def transform_wide_power(base: u64, exponent: u64, p: u64, inverse: u64, r: u64, r2: u64) -> u64:
    mut x = transform_wide_multiply(base, r2, p, inverse)
    mut power = exponent
    mut result = r
    while power > 0u64:
        if power & 1u64 != 0u64:
            result = transform_wide_multiply(result, x, p, inverse)
        x = transform_wide_multiply(x, x, p, inverse)
        power >>= 1u64
    result

def transform_wide_load(words: &[u64], out: &mut [u64], p: u64, inverse: u64, load_factor: u64) -> ():
    unchecked:
        count = (len(words) + 1) // 2
        for i in range(count):
            low = words[2 * i]
            high = words[2 * i + 1] if 2 * i + 1 < len(words) else 0u64
            reduced = transform_wide_reduce(low, high % p, p, inverse)
            out[i] = transform_wide_multiply(reduced, load_factor, p, inverse)
        for i in range(count, len(out)):
            out[i] = 0u64

def transform_wide_roots(roots: &mut [u64], prime: TransformPrime) -> u64:
    unchecked:
        n = u64(2 * len(roots))
        exponent = (prime.p - 1u64) // n
        root = transform_wide_power(prime.generator, exponent, prime.p, prime.inverse, prime.r, prime.r2)
        roots[0] = prime.r
        for i in range(1, len(roots)):
            roots[i] = transform_wide_multiply(roots[i - 1], root, prime.p, prime.inverse)
        # n divides p-1, so n * (p - exponent) is one modulo p.
        prime.p - exponent

def transform_wide_product(a: &[u64], b: &[u64], x: &mut [u64], y: &mut [u64], roots: &mut [u64], count: i64, prime: TransformPrime, square: bool) -> ():
    scale = transform_wide_roots(roots, prime)
    transform_wide_prepare(a, x, count, roots, prime, prime.r3)
    if square:
        for i in range(count):
            residue = transform_wide_multiply(x[i], x[i], prime.p, prime.inverse)
            x[i] = transform_wide_multiply(residue, scale, prime.p, prime.inverse)
    else:
        load_factor = transform_wide_multiply(prime.r3, scale, prime.p, prime.inverse)
        transform_wide_prepare(b, y, count, roots, prime, load_factor)
        transform_wide_pointwise(&mut x[:count], y, prime.p, prime.inverse)
    transform_wide_finish(x, roots, count, prime.p, prime.inverse)

# The first Montgomery reduction loads a digit with factor R^-1. The
# second one loads it with factor load_factor/R^2. Use R^3 for an ordinary
# Montgomery operand and R^2/n for the normalized operand. The pointwise
# product is then in standard representation and scaled by 1/n.
def transform_wide_prepare(a: &[u64], x: &mut [u64], count: i64, roots: &[u64], prime: TransformPrime, load_factor: u64) -> ():
    unchecked:
        transform_wide_load(a, x, prime.p, prime.inverse, load_factor)
        transform_wide_forward_truncated(x, (len(a) + 1) // 2, count, roots, prime.p, prime.inverse)

def transform_wide_pointwise(x: &mut [u64], y: &[u64], p: u64, inverse: u64) -> ():
    for i in range(len(x)):
        x[i] = transform_wide_multiply(x[i], y[i], p, inverse)

def transform_wide_finish(x: &mut [u64], roots: &[u64], count: i64, p: u64, inverse: u64) -> ():
    clear_words(&mut x[count:])
    transform_wide_inverse_truncated(x, count, roots, p, inverse)

class PreparedTransform:
    prime: TransformPrime
    count: i64
    roots: list[u64]
    points: list[u64]

    def multiply(self, a: &[u64], x: &mut [u64]) -> ():
        p = self.prime.p
        inverse = self.prime.inverse
        transform_wide_prepare(a, x, self.count, &self.roots, self.prime, self.prime.r3)
        transform_wide_pointwise(&mut x[:self.count], &self.points, p, inverse)
        transform_wide_finish(x, &self.roots, self.count, p, inverse)

def prepare_transform(words: &[u64], n: i64, count: i64, prime: TransformPrime) -> Result[PreparedTransform, AllocError]:
    mut roots = zeros(n // 2)?
    mut points = zeros(n)?
    scale = transform_wide_roots(&mut roots, prime)
    load_factor = transform_wide_multiply(prime.r3, scale, prime.p, prime.inverse)
    transform_wide_prepare(words, &mut points, count, &roots, prime, load_factor)
    Ok(PreparedTransform(prime, count, roots, points))

# In decimation-in-frequency order the first half of the values comes
# from the sums of the coefficient halves. The second half comes from
# their differences multiplied by the roots. Recurse only into the
# halves that contain requested values and skip butterflies on zeros.
def transform_wide_forward_truncated(data: &mut [u64], inputs: i64, count: i64, roots: &[u64], p: u64, inverse: u64) -> ():
    unchecked:
        n = len(data)
        if count == n:
            transform_wide_forward(data, roots, p, inverse)
            return
        half = n // 2
        left = &mut data[:half]
        right = &mut data[half:]
        present = half if inputs > half else inputs
        paired = inputs - present
        if count <= half:
            for i in range(paired):
                left[i] = reduce_transform_word(left[i] + right[i], p)
            transform_wide_forward_truncated(left, present, count, roots, p, inverse)
            return
        step = (2 * len(roots)) // n
        transform_wide_forward_block(&mut left[:paired], &mut right[:paired], roots, step, p, inverse)
        mut root_index = paired * step
        for i in range(paired, present):
            right[i] = transform_wide_multiply(left[i], roots[root_index], p, inverse)
            root_index += step
        transform_wide_forward(left, roots, p, inverse)
        transform_wide_forward_truncated(right, present, count - half, roots, p, inverse)

# Slots after count hold known coefficients scaled by the local length,
# rather than transform values. At entry to the root they are zero.
# Each split derives the known coefficients for the truncated child
# before its inverse, which returns coefficients scaled by half.
def transform_wide_inverse_truncated(data: &mut [u64], count: i64, roots: &[u64], p: u64, inverse: u64) -> ():
    unchecked:
        n = len(data)
        if count == n:
            transform_wide_inverse(data, roots, p, inverse)
            return
        half = n // 2
        left = &mut data[:half]
        right = &mut data[half:]
        if count <= half:
            for i in range(count, half):
                sum = reduce_transform_word(left[i] + right[i], p)
                left[i] = (sum + (sum & 1u64) * p) >> 1u64
            transform_wide_inverse_truncated(left, count, roots, p, inverse)
            for i in range(count):
                doubled = reduce_transform_word(left[i] + left[i], p)
                left[i] = reduce_transform_word(doubled + p - right[i], p)
            return
        step = (2 * len(roots)) // n
        tail = count - half
        transform_wide_inverse(left, roots, p, inverse)
        mut root_index = tail * step
        for i in range(tail, half):
            difference = reduce_transform_word(left[i] + p - right[i], p)
            left[i] = reduce_transform_word(left[i] + difference, p)
            right[i] = transform_wide_multiply(difference, roots[root_index], p, inverse)
            root_index += step
        transform_wide_inverse_truncated(right, tail, roots, p, inverse)
        transform_wide_inverse_block(&mut left[:tail], &mut right[:tail], roots, step, p, inverse)

def transform_wide_forward(data: &mut [u64], roots: &[u64], p: u64, inverse: u64) -> ():
    unchecked:
        n = len(data)
        mut width = n
        mut step = (2 * len(roots)) // n
        while width >= 2:
            half = width // 2
            mut start = 0
            while start < n:
                block = &mut data[start:start + width]
                transform_wide_forward_block(&mut block[:half], &mut block[half:], roots, step, p, inverse)
                start += width
            width = half
            step *= 2

def transform_wide_inverse(data: &mut [u64], roots: &[u64], p: u64, inverse: u64) -> ():
    unchecked:
        n = len(data)
        mut width = 2
        mut step = len(roots)
        while width <= n:
            half = width // 2
            mut start = 0
            while start < n:
                block = &mut data[start:start + width]
                transform_wide_inverse_block(&mut block[:half], &mut block[half:], roots, step, p, inverse)
                start += width
            width *= 2
            step //= 2

def transform_wide_forward_block(low: &mut [u64], high: &mut [u64], roots: &[u64], step: i64, p: u64, inverse: u64) -> ():
    unchecked:
        mut k = 0
        for j in range(len(low)):
            u = low[j]
            v = high[j]
            sum = u + v
            difference = u + p - v
            low[j] = reduce_transform_word(sum, p)
            high[j] = transform_wide_multiply(reduce_transform_word(difference, p), roots[k], p, inverse)
            k += step

def transform_wide_inverse_block(low: &mut [u64], high: &mut [u64], roots: &[u64], step: i64, p: u64, inverse: u64) -> ():
    unchecked:
        mut k = 0
        for j in range(len(low)):
            root = roots[0] if k == 0 else p - roots[len(roots) - k]
            u = low[j]
            v = transform_wide_multiply(high[j], root, p, inverse)
            sum = u + v
            difference = u + p - v
            low[j] = reduce_transform_word(sum, p)
            high[j] = reduce_transform_word(difference, p)
            k += step

# Garner's mixed-radix conversion uses exact modular products. The fixed
# inverse constants and Proth witnesses are independently regenerated in
# the experiment proof, including every cross-prime residue.
def transform_garner_step(value: u64, digit: u64, reciprocal: u64, p: u64, inverse: u64, r2: u64) -> u64:
    unchecked:
        d = value + p - digit % p
        difference = d - p if d >= p else d
        product = transform_wide_multiply(difference, reciprocal, p, inverse)
        transform_wide_multiply(product, r2, p, inverse)

def transform_wide_recover(a: &[u64], b: &[u64], c: &[u64], d: &[u64], e: &[u64], out: &mut [u64]) -> (u64, u64, u64):
    unchecked:
        mut carry0 = 0u64
        mut carry1 = 0u64
        mut carry2 = 0u64
        for i in range((len(out) + 1) // 2):
            c0 = a[i]
            c1 = transform_garner_step(b[i], c0, 312876447629491759u64, 1152702701792919553u64, 1152702701792919551u64, 549807853720474145u64)
            c2 = transform_garner_step(transform_garner_step(c[i], c0, 171887048208605330u64, 1152654323281297409u64, 1152654323281297407u64, 1065844120376875002u64), c1, 864490742460949231u64, 1152654323281297409u64, 1152654323281297407u64, 1065844120376875002u64)
            c3 = transform_garner_step(transform_garner_step(transform_garner_step(d[i], c0, 1143042328493092594u64, 1152647726211530753u64, 1152647726211530751u64, 726084339089016087u64), c1, 207476590718054569u64, 1152647726211530753u64, 1152647726211530751u64, 726084339089016087u64), c2, 960539771842767573u64, 1152647726211530753u64, 1152647726211530751u64, 726084339089016087u64)
            c4 = transform_garner_step(transform_garner_step(transform_garner_step(transform_garner_step(e[i], c0, 43848051642774040u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64), c1, 272978847821206010u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64), c2, 938527276794829683u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64), c3, 126063148472975365u64, 1152577357467353089u64, 1152577357467353087u64, 1052221714738828282u64)
            mut x0 = c4
            mut x1 = 0u64
            mut x2 = 0u64
            mut x3 = 0u64
            mut x4 = 0u64
            for j in range(4):
                prime = 1152647726211530753u64 if j == 0 else (1152654323281297409u64 if j == 1 else (1152702701792919553u64 if j == 2 else 1152779667606863873u64))
                digit = c3 if j == 0 else (c2 if j == 1 else (c1 if j == 2 else c0))
                (lo0, hi0) = x0.widening_mul(prime)
                (lo1, hi1) = x1.widening_mul(prime)
                (lo2, hi2) = x2.widening_mul(prime)
                (lo3, hi3) = x3.widening_mul(prime)
                (lo4, _) = x4.widening_mul(prime)
                (next0, t0) = lo0.carrying_add(digit, False)
                (next1, t1) = lo1.carrying_add(hi0, t0)
                (next2, t2) = lo2.carrying_add(hi1, t1)
                (next3, t3) = lo3.carrying_add(hi2, t2)
                (next4, _) = lo4.carrying_add(hi3, t3)
                x0 = next0
                x1 = next1
                x2 = next2
                x3 = next3
                x4 = next4
            (word0, t0) = x0.carrying_add(carry0, False)
            (word1, t1) = x1.carrying_add(carry1, t0)
            (next0, t2) = x2.carrying_add(carry2, t1)
            (next1, t3) = x3.carrying_add(0u64, t2)
            carry0 = next0
            carry1 = next1
            carry2 = x4 + (1u64 if t3 else 0u64)
            out[2 * i] = word0
            if 2 * i + 1 < len(out):
                out[2 * i + 1] = word1
        (carry0, carry1, carry2)

def multiply_schoolbook(a: &[u64], b: &[u64], out: &mut [u64]) -> ():
    unchecked:
        for i in range(len(a)):
            x = a[i]
            mut carry = 0u64
            for j in range(len(b)):
                (low, high) = x.widening_mul(b[j])
                previous = out[i + j]
                sum = low.wrapping_add(previous)
                total = sum.wrapping_add(carry)
                out[i + j] = total
                # An addition carries when its wrapped sum is below its
                # first operand. The second operand is their difference.
                carry = high + borrow_bit(sum, low, previous) + borrow_bit(total, sum, carry)
            out[i + len(b)] = carry

def quotient_remainder(a: &BigInt, b: &BigInt) -> Result[(BigInt, BigInt), AllocError]:
    match &a._value:
        case Value.Small(x):
            match &b._value:
                case Value.Small(y):
                    result = checked:
                        (*x // *y, *x % *y)
                    match result:
                        case Ok(pair):
                            (q, r) = pair
                            return Ok((from_i64(q), from_i64(r)))
                        case Err(_):
                            pass
                case _:
                    pass
        case _:
            pass
    (quotient, rest) = divide_magnitude(a, b)?
    mut q = canonical(a.is_negative() != b.is_negative(), quotient)
    mut remainder = canonical(False, rest)
    if a.is_negative() != b.is_negative() and not remainder.is_zero():
        q = (q - from_i64(1))?
        remainder = canonical(b.is_negative(), magnitude_sub(b, &remainder)?)
    elif b.is_negative() and not remainder.is_zero():
        remainder = (-remainder)?
    Ok((q, remainder))

# The short-division fallback uses radix 2^32 scratch for magnitudes
# stored in radix 2^64.
def digits32(value: &BigInt) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = list[u64].with_capacity(value.word_len() * 2)?
        for i in range(value.word_len()):
            out.append(value.word(i) & 4294967295u64)?
            out.append(value.word(i) >> 32u64)?
        trim(&mut out)
        Ok(out)

def pack32(digits: &[u64]) -> Result[list[u64], AllocError]:
    unchecked:
        mut out = list[u64].with_capacity((len(digits) + 1) // 2)?
        mut i = 0
        while i < len(digits):
            high = digits[i + 1] if i + 1 < len(digits) else 0u64
            out.append(digits[i] | (high << 32u64))?
            i += 2
        Ok(out)

def scale32(digits: &mut list[u64], factor: u64) -> Result[(), AllocError]:
    unchecked:
        mut carry = 0u64
        for i in range(len(digits)):
            value = digits[i] * factor + carry
            digits[i] = value & 4294967295u64
            carry = value >> 32u64
        if carry != 0u64:
            digits.append(carry)?
        Ok(())

const WIDE_DIVISION_LIMBS: i64 = 2
# Quotient-block sizes are measured in significant normalized limbs.
const DIVISION_BLOCK_LIMBS: i64 = 768
const RADIX_DIVISION_BLOCK_LIMBS: i64 = 1200
const RADIX_RECIPROCAL_LIMBS: i64 = 2049
const NEWTON_RECIPROCAL_LIMBS: i64 = 4096
const DIVISION_RECIPROCAL_LIMBS: i64 = 6144
const RECIPROCAL_TAIL_LIMBS: i64 = 768

def divide_magnitude(a: &BigInt, b: &BigInt) -> Result[(list[u64], list[u64]), AllocError]:
    if b.word_len() >= WIDE_DIVISION_LIMBS and magnitude_cmp(a, b) >= 0:
        mut divisor = prepare_wide_divisor(b)?
        divisor.prepare_division_reciprocal(a.word_len())?
        return divide_wide(a, &divisor)
    divide_narrow(a, b)

# Normalize to a top limb of at least 2^63, omitting exactly zero low
# divisor limbs. Store the extra numerator limb even when there is no carry.
def normalize_division(value: &BigInt, first: i64, shift: u64, extra: i64) -> Result[list[u64], AllocError]:
    unchecked:
        count = value.word_len() - first
        mut out = zeros(count + extra)?
        if shift == 0u64:
            for i in range(count):
                out[i] = value.word(first + i)
        else:
            mut carry = 0u64
            for i in range(count):
                word = value.word(first + i)
                out[i] = (word << shift) | carry
                carry = word >> (64u64 - shift)
            if extra != 0:
                out[count] = carry
        Ok(out)

def inverse_division_word(divisor: u64) -> u64:
    # The high limb of B^2-1 yields quotient one. Start with its
    # remainder and shift in the 64 ones of the low limb.
    mut inverse = 0u64
    mut remainder = divisor ^ u64.MAX
    for _ in range(64):
        doubled = (remainder << 1u64) | 1u64
        subtract = (remainder >> 63u64) != 0u64 or doubled >= divisor
        remainder = doubled.wrapping_sub(divisor) if subtract else doubled
        inverse = (inverse << 1u64) | (1u64 if subtract else 0u64)
    inverse

# The leading one of the fixed-point reciprocal is implicit. The
# correction uses B^cyclic_words-1 and, when needed, a short low product.
class DivisionReciprocal:
    digits: list[u64]
    cyclic_words: i64

# The omitted low limbs are zero in the divisor, so the corresponding
# low dividend limbs pass directly to the remainder.
class WideDivisor:
    first: i64
    shift: u64
    digits: list[u64]
    inverse: u64
    reciprocal: Option[DivisionReciprocal]

    def prepare_division_reciprocal(self: &mut WideDivisor, dividend_limbs: i64) -> Result[(), AllocError]:
        unchecked:
            n = len(self.digits)
            high = dividend_limbs - self.first - n
            if n < DIVISION_RECIPROCAL_LIMBS or n >= MAX_TRANSFORM_WORDS or high < n or high > 2 * n:
                return Ok(())
            cyclic = division_cyclic_width(n)
            if cyclic == 0:
                return Ok(())
            blocks = (high + n - 2) // (n - 1)
            width = (high + blocks - 1) // blocks
            tail = high - (blocks - 1) * width
            if tail < RECIPROCAL_TAIL_LIMBS or n + tail <= cyclic:
                return Ok(())
            digits = division_reciprocal_newton(&self.digits, width)?
            self.reciprocal = Some(DivisionReciprocal(digits, cyclic))
            Ok(())

    def prepare_radix_reciprocal(self: &mut WideDivisor, dividend_limbs: i64) -> Result[(), AllocError]:
        unchecked:
            n = len(self.digits)
            if n < RADIX_RECIPROCAL_LIMBS or self.reciprocal.is_some() or n >= MAX_TRANSFORM_WORDS:
                return Ok(())
            quotient_limbs = dividend_limbs - self.first - n
            # The cyclic reciprocal path pays for itself on repeated
            # splits whose quotient is wider after low zero limbs are
            # omitted. Divide the quotient into roughly equal blocks.
            if quotient_limbs <= n + n // 4:
                return Ok(())
            half_cyclic = power_of_two_at_most(n)
            fitted = division_cyclic_width(n)
            cyclic = 2 * half_cyclic if fitted == 0 else fitted
            target = (quotient_limbs + 1) // 2
            block = half_cyclic if half_cyclic > target else target
            width = block if block < n else n - 1
            if n + width > cyclic and quotient_limbs >= width:
                digits = if width >= NEWTON_RECIPROCAL_LIMBS:
                    division_reciprocal_newton(&self.digits, width)?
                else:
                    division_reciprocal(&self.digits, width)?
                self.reciprocal = Some(DivisionReciprocal(digits, cyclic))
            Ok(())

def prepare_wide_divisor(value: &BigInt) -> Result[WideDivisor, AllocError]:
    unchecked:
        mut first = 0
        while value.word(first) == 0u64:
            first += 1
        shift = u64((64 - value.bit_length() % 64) % 64)
        digits = normalize_division(value, first, shift, 0)?
        inverse = inverse_division_word(digits[-1])
        Ok(WideDivisor(first, shift, digits, inverse, Nothing))

def divide_wide(a: &BigInt, b: &WideDivisor, block_limbs: i64 = DIVISION_BLOCK_LIMBS) -> Result[(list[u64], list[u64]), AllocError]:
    unchecked:
        first = b.first
        shift = b.shift
        n = len(b.digits)
        mut u = normalize_division(a, first, shift, 1)?
        mut q = zeros(len(u) - n)?
        match &b.reciprocal:
            case Some(reciprocal):
                divide_reciprocal_digits(&mut u, &b.digits, &mut q, b.inverse, reciprocal, block_limbs)?
            case Nothing:
                divide_normalized(&mut u, &b.digits, &mut q, b.inverse, block_limbs)?
        mut r = zeros(first + n)?
        for i in range(first):
            r[i] = a.word(i)
        if shift == 0u64:
            for i in range(n):
                r[first + i] = u[i]
        else:
            for i in range(n - 1):
                r[first + i] = (u[i] >> shift) | (u[i + 1] << (64u64 - shift))
            r[-1] = u[n - 1] >> shift
        Ok((q, r))

# With B = 2^64 and hi < d, floor((hi*B+lo)*(B+inverse)/B^2)
# is at most one below the exact quotient. The three-term carry from
# hi*inverse + lo + high(lo*inverse) forms the high half of this product.
# Use q*d to correct the quotient and obtain the remainder.
def estimate_division_word(hi: u64, lo: u64, d: u64, inverse: u64) -> (u64, u64):
    (p0, p1) = hi.widening_mul(inverse)
    (_, p2) = lo.widening_mul(inverse)
    (sum, carry0) = p0.carrying_add(lo, False)
    (_, carry1) = sum.carrying_add(p2, False)
    q = hi.wrapping_add(p1).wrapping_add(1u64 if carry0 else 0u64).wrapping_add(1u64 if carry1 else 0u64)
    (low, high) = q.widening_mul(d)
    r = lo.wrapping_sub(low)
    overflow = hi != high.wrapping_add(1u64 if lo < low else 0u64)
    if overflow or r >= d:
        (q.wrapping_add(1u64), r.wrapping_sub(d))
    else:
        (q, r)

def divide_normalized(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64, block_limbs: i64) -> Result[(), AllocError]:
    unchecked:
        n = len(v)
        high = len(q) - 1
        if n < 2 * block_limbs or high < block_limbs:
            divide_wide_digits(u, v, q, inverse)
            return Ok(())
        # For a short quotient, the first estimate divides the top 2k
        # dividend limbs by the top k divisor limbs. Its correction
        # multiplies k by n-k limbs. Use this path when that product can
        # use transforms, including a skewed product in full-width tiles.
        omitted = n - high
        if high < n // 2 and not (use_transform(high, omitted) or use_skewed_product(omitted, high)):
            divide_wide_digits(u, v, q, inverse)
            return Ok(())
        # The extra dividend limb may be nonzero after normalization.
        # Resolve the top quotient limb to make the n-limb remainder < v.
        divide_wide_digits(&mut u[high:], v, &mut q[high:], inverse)
        mut scratch = zeros(n)?
        divide_blocked_digits(&mut u[:high + n], v, &mut q[:high], inverse, &mut scratch)

# Divide successive quotient blocks from most significant to least. The
# low half omitted by the recursive estimate is restored by multiplication.
def divide_blocked_digits(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64, scratch: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        n = len(v)
        mut high = len(q)
        while high > 0:
            if n < 2 * DIVISION_BLOCK_LIMBS or high < DIVISION_BLOCK_LIMBS:
                divide_wide_digits(&mut u[:n + high], v, &mut q[:high], inverse)
                return Ok(())
            half = (n + 1) // 2
            k = half if half < high else high
            offset = high - k
            first = n - k
            start = offset + first
            top = &v[first:]
            mut carry = False
            if compare_division_words(&u[high + first:high + n], top) == 0:
                # The true quotient fits k limbs. Clamp its estimate to
                # B^k-1; the truncated remainder is the low k limbs plus top.
                for i in range(k):
                    q[offset + i] = u64.MAX
                carry = add_division_words(&mut u[start:start + k], top)
            else:
                divide_blocked_digits(&mut u[start:high + n], top, &mut q[offset:high], inverse, scratch)?
            product = &mut scratch[:n]
            clear_words(product)
            multiply_into(&q[offset:high], &v[:first], product)?
            # Only the clamped prefix remainder can have an extra limb.
            # A negative difference needs at most two additions of v.
            row = &mut u[offset:offset + n]
            borrow = subtract_division_words(row, product)
            mut negative = not carry and borrow != 0u64
            while negative:
                drop(decrement_words(&mut q[offset:high]))
                negative = not add_division_words(row, v)
            high = offset
        Ok(())

def compare_division_words(a: &[u64], b: &[u64]) -> i64:
    unchecked:
        mut i = len(b)
        while i > 0:
            i -= 1
            if a[i] != b[i]:
                return -1 if a[i] < b[i] else 1
        0

def clear_words(words: &mut [u64]) -> ():
    for word in words:
        *word = 0u64

def decrement_words(words: &mut [u64]) -> bool:
    for word in words:
        *word = (*word).wrapping_sub(1u64)
        if *word != u64.MAX:
            return False
    True

def increment_words(words: &mut [u64]) -> bool:
    for word in words:
        *word = (*word).wrapping_add(1u64)
        if *word != 0u64:
            return False
    True

def add_division_words(row: &mut [u64], words: &[u64]) -> bool:
    mut carry = False
    for i in range(len(row)):
        (sum, overflow) = row[i].carrying_add(words[i], carry)
        row[i] = sum
        carry = overflow
    carry

def subtract_division_words(row: &mut [u64], words: &[u64]) -> u64:
    mut borrow = 0u64
    for i in range(len(row)):
        a = row[i]
        b = words[i]
        partial = a.wrapping_sub(b)
        difference = partial.wrapping_sub(borrow)
        row[i] = difference
        borrow = borrow_bit(a, b, partial) | borrow_bit(partial, borrow, difference)
    borrow

# Write the product modulo B^len(out) into a zeroed destination.
def multiply_low_into(a: &[u64], b: &[u64], out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        n = len(out)
        al = n if len(a) > n else len(a)
        bl = n if len(b) > n else len(b)
        if al == 0 or bl == 0:
            return Ok(())
        if al + bl <= n:
            return multiply_into(&a[:al], &b[:bl], &mut out[:al + bl])
        if n <= 64 or al < 16 or bl < 16:
            for i in range(al):
                x = a[i]
                count = n - i if bl > n - i else bl
                mut carry = 0u64
                for j in range(count):
                    (low, high) = x.widening_mul(b[j])
                    previous = out[i + j]
                    sum = low.wrapping_add(previous)
                    total = sum.wrapping_add(carry)
                    out[i + j] = total
                    carry = high + borrow_bit(sum, low, previous) + borrow_bit(total, sum, carry)
                if i + count < n:
                    out[i + count] = carry
            return Ok(())
        # Only the two cross-products can contribute above the split.
        # An odd output width also keeps one limb of the high product.
        split = n // 2
        alow = split if al > split else al
        blow = split if bl > split else bl
        multiply_into(&a[:alow], &b[:blow], &mut out[:alow + blow])?
        if 2 * split < n and al > split and bl > split:
            out[-1] = a[split].wrapping_mul(b[split])
        mut partial = zeros(n - split)?
        multiply_low_into(&a[:alow], &b[blow:bl], &mut partial)?
        drop(add_division_words(&mut out[split:], &partial))
        clear_words(&mut partial)
        multiply_low_into(&b[:blow], &a[alow:al], &mut partial)?
        drop(add_division_words(&mut out[split:], &partial))
        Ok(())

# B^width-1 gives cheap wraparound convolution at a power-of-two width.
# A short low product recovers the extra limbs when the divisor is close
# above that width. Prefer a larger direct cyclic product when it fits.
def division_cyclic_width(n: i64) -> i64:
    unchecked:
        lower = power_of_two_at_most(n)
        # Keep the short product within an eighth of the width plus one limb.
        if n - lower <= lower // 8:
            return lower
        if n >= lower + lower // 2:
            return 2 * lower
        0

def fold_cyclic(source: &[u64], out: &mut [u64]) -> ():
    unchecked:
        n = len(out)
        first = n if len(source) > n else len(source)
        copy_words(source, &mut out[:first])
        clear_words(&mut out[first:])
        mut offset = n
        while offset < len(source):
            count = n if len(source) - offset > n else len(source) - offset
            if add_division_words(&mut out[:count], &source[offset:offset + count]) and increment_words(&mut out[count:]):
                drop(increment_words(out))
            offset += count

# B^width-1 and zero encode the same residue.
def canonical_cyclic_zero(out: &mut [u64]) -> ():
    if out[0] != u64.MAX or out[-1] != u64.MAX:
        return
    for word in out:
        if *word != u64.MAX:
            return
    clear_words(out)

def multiply_wraparound(a: &[u64], b: &[u64], out: &mut [u64]) -> Result[(), AllocError]:
    unchecked:
        n = len(out)
        if len(a) > n:
            mut x = zeros(n)?
            fold_cyclic(a, &mut x)
            multiply_wraparound(&x, b, out)?
            return Ok(())
        if len(b) > n:
            mut y = zeros(n)?
            fold_cyclic(b, &mut y)
            return multiply_transform_wide_into(a, &y, out, True)
        multiply_transform_wide_into(a, b, out, True)

def power_of_two_at_most(n: i64) -> i64:
    unchecked:
        mut k = 1
        while k <= n // 2:
            k *= 2
        k

def division_reciprocal_newton(v: &[u64], k: i64) -> Result[list[u64], AllocError]:
    unchecked:
        width = k + 1
        estimate = reciprocal_at_precision(v, width)?
        # Omit the low guard limb and the implicit leading one.
        estimate[1:width]

# For the upward-rounded width-limb prefix D, return a lower bound on
# B^(2*width)/D with error less than two. Round up at each precision so
# extending the divisor can only increase its fixed-point reciprocal.
def reciprocal_at_precision(v: &[u64], width: i64) -> Result[list[u64], AllocError]:
    unchecked:
        mut prefix = v[len(v) - width:]?
        mut result = zeros(width + 1)?
        if increment_words(&mut prefix):
            result[width] = 1u64
            return Ok(result)
        if width <= 16:
            mut numerator = [u64.MAX for _ in range(2 * width)]?
            result[width] = 1u64
            drop(subtract_division_words(&mut numerator[width:], &prefix))
            divide_wide_digits(&mut numerator, &prefix, &mut result[:width], inverse_division_word(prefix[-1]))
            return Ok(result)

        # With l the old precision and m the new precision, the lifted
        # estimate has error <6*B^(m-l), allowing for the omitted divisor
        # limbs as well as rounding. The residual B^(m+l) - D*estimate
        # is nonnegative and fits in m+1 limbs.
        old = (width + 2) // 2
        estimate = reciprocal_at_precision(v, old)?
        mut residual = zeros(width + 1)?
        cyclic = division_cyclic_width(width) if width >= 2048 else 0
        if cyclic != 0 and cyclic < width + len(estimate):
            # Recover the residual from the bounded wraparound product.
            # B^(m+l) wraps to a single one at exponent (m+l) mod C.
            mut product = zeros(cyclic)?
            multiply_wraparound(&prefix, &estimate, &mut product)?
            mut folded = zeros(cyclic)?
            folded[(width + old) % cyclic] = 1u64
            if subtract_division_words(&mut folded, &product) != 0u64:
                drop(decrement_words(&mut folded))
            canonical_cyclic_zero(&mut folded)
            if cyclic <= width:
                recover_cyclic_tail(&mut residual, &folded, &prefix, &estimate)?
            else:
                copy_words(&folded, &mut residual)
        else:
            product = multiply(&prefix, &estimate)?
            drop(subtract_division_words(&mut residual, &product[:width + 1]))

        # Lift the reciprocal and add floor(estimate * residual / B^(2l)).
        # Since m <= 2l-1, the new error including rounding is <1+36/B.
        correction = multiply(&estimate, &residual)?
        copy_words(&estimate, &mut result[width - old:])
        add_shifted(&mut result, &correction[2 * old:], 0)
        Ok(result)

# Divide by the rounded-up k+1 limb prefix and discard one guard limb.
# This gives a lower bound on B^(n+k)/v with error less than two.
def division_reciprocal(v: &[u64], k: i64) -> Result[list[u64], AllocError]:
    unchecked:
        width = k + 1
        mut prefix = v[len(v) - width:]?
        if increment_words(&mut prefix):
            return zeros(k)
        mut numerator = [u64.MAX for _ in range(2 * width)]?
        mut full = zeros(width)?
        mut scratch = zeros(width)?
        # The upper width limbs of B^(2*width)-1 are at least the prefix.
        # The implicit high quotient limb is therefore one.
        drop(subtract_division_words(&mut numerator[width:], &prefix))
        divide_blocked_digits(&mut numerator, &prefix, &mut full, inverse_division_word(prefix[-1]), &mut scratch)?
        Ok(full[1:]?)

# The nonnegative Barrett correction is below 5*B^n. If the cyclic
# width C does not cover all n+1 limbs, R = A + t*(B^C-1) for canonical
# residue A and 0 <= t < B^(n+1-C). Reduce this relation modulo
# B^(n+1-C) to get t from A and a short product for R's low limbs.
def subtract_cyclic_product(u: &mut [u64], v: &[u64], q: &[u64], product: &mut [u64], folded: &mut [u64]) -> Result[u64, AllocError]:
    unchecked:
        width = len(product)
        n = len(v)
        multiply_wraparound(v, q, product)?
        fold_cyclic(u, folded)
        if subtract_division_words(folded, product) != 0u64:
            drop(decrement_words(folded))
        canonical_cyclic_zero(folded)
        if width > n:
            copy_words(folded, &mut u[:n])
            return Ok(folded[n])

        recover_cyclic_tail(&mut u[:n + 1], folded, v, q)?
        Ok(u[n])

# The destination initially contains the low limbs of the minuend.
# With gap <= width, the two moduli B^gap and B^width-1 give the wrap
# count in the top row. Subtract that count from the cyclic residue
# and propagate any borrow across the split to reconstruct the integer.
def recover_cyclic_tail(out: &mut [u64], residue: &[u64], a: &[u64], b: &[u64]) -> Result[(), AllocError]:
    unchecked:
        width = len(residue)
        gap = len(out) - width
        low = &mut out[:width]
        top = &mut out[width:]
        clear_words(top)
        multiply_low_into(a, b, top)?
        drop(subtract_division_words(top, &low[:gap]))
        drop(add_division_words(top, &residue[:gap]))
        copy_words(residue, low)
        if subtract_division_words(&mut low[:gap], top) != 0u64 and decrement_words(&mut low[gap:]):
            drop(decrement_words(top))
        Ok(())

# H is the high k limbs of the current remainder. The next quotient
# block is at least floor(H * (B^k + reciprocal) / B^k). Subtract its
# product with the divisor and advance the estimate until the remainder
# is smaller than the divisor.
def divide_reciprocal_digits(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64, reciprocal: &DivisionReciprocal, block_limbs: i64) -> Result[(), AllocError]:
    unchecked:
        n = len(v)
        width = len(reciprocal.digits)
        cyclic = reciprocal.cyclic_words
        mut high = len(q) - 1
        if high < RECIPROCAL_TAIL_LIMBS or n + high <= cyclic:
            return divide_normalized(u, v, q, inverse, block_limbs)
        divide_wide_digits(&mut u[high:], v, &mut q[high:], inverse)
        product_size = 2 * width if 2 * width > cyclic else cyclic
        mut scratch = zeros(product_size)?
        mut folded = zeros(cyclic)?
        while high > 0:
            k = width if width < high else high
            if k < RECIPROCAL_TAIL_LIMBS or n + k <= cyclic:
                divide_wide_digits(&mut u[:n + high], v, &mut q[:high], inverse)
                break
            offset = high - k
            top = &u[high + n - k:high + n]
            product = &mut scratch[:2 * k]
            clear_words(product)
            multiply_into(top, &reciprocal.digits[width - k:], product)?
            quotient = &mut q[offset:high]
            copy_words(top, quotient)
            drop(add_division_words(quotient, &product[k:]))
            mut upper = subtract_cyclic_product(&mut u[offset:high + n], v, quotient, &mut scratch[:cyclic], &mut folded)?
            row = &mut u[offset:offset + n]
            while upper != 0u64 or compare_division_words(row, v) >= 0:
                drop(increment_words(quotient))
                upper = upper.wrapping_sub(subtract_division_words(row, v))
            high = offset
        Ok(())

def divide_wide_digits(u: &mut [u64], v: &[u64], q: &mut [u64], inverse: u64) -> ():
    unchecked:
        n = len(v)
        divisor = v[n - 1]
        mut j = len(q)
        while j > 0:
            j -= 1
            hi = u[j + n]
            lo = u[j + n - 1]
            mut guess = u64.MAX
            mut residual = lo.wrapping_add(divisor)
            mut residual_wide = residual < lo
            if hi != divisor:
                (trial, rem) = estimate_division_word(hi, lo, divisor, inverse)
                guess = trial
                residual = rem
                residual_wide = False
            if n > 1:
                next = u[j + n - 2]
                while not residual_wide:
                    (low, high) = guess.widening_mul(v[n - 2])
                    if high < residual or (high == residual and low <= next):
                        break
                    guess -= 1u64
                    updated = residual.wrapping_add(divisor)
                    residual_wide = updated < residual
                    residual = updated
            # This high limb is outside every later row. Only its borrow
            # determines whether the divisor must be added back.
            row = &mut u[j:j + n]
            borrow = subtract_wide_product(row, v, guess)
            if hi < borrow:
                mut carry = False
                for i in range(n):
                    (word, overflow) = row[i].carrying_add(v[i], carry)
                    row[i] = word
                    carry = overflow
                guess -= 1u64
            q[j] = guess

# Subtract the low product and the incoming borrow in two steps. Add
# each step's borrow bit to the high product. Each bit follows from the
# signs of a, b and a-b: when a and b have different top bits, borrow if
# b has the top bit set. When they agree, use the top bit of a-b.
# Computing the bits arithmetically keeps both subtractions branch-free.
def subtract_wide_product(row: &mut [u64], v: &[u64], q: u64) -> u64:
    mut borrow = 0u64
    for i in range(len(row)):
        (lo, hi) = q.widening_mul(v[i])
        old = row[i]
        difference = old.wrapping_sub(lo)
        result = difference.wrapping_sub(borrow)
        first = borrow_bit(old, lo, difference)
        second = borrow_bit(difference, borrow, result)
        row[i] = result
        borrow = hi.wrapping_add(first).wrapping_add(second)
    borrow

def borrow_bit(a: u64, b: u64, difference: u64) -> u64:
    complement = a ^ u64.MAX
    ((b & complement) | ((b | complement) & difference)) >> 63u64

# Single stored limbs keep the base-2^32 Algorithm D path.
def divide_narrow(a: &BigInt, b: &BigInt) -> Result[(list[u64], list[u64]), AllocError]:
    unchecked:
        if magnitude_cmp(a, b) < 0:
            empty: list[u64] = []?
            return Ok((empty, words(a)?))
        mut u = digits32(a)?
        mut v = digits32(b)?
        n = len(v)
        m = len(u) - n
        factor = 4294967296u64 // (v[-1] + 1u64)
        if factor != 1u64:
            scale32(&mut u, factor)?
            scale32(&mut v, factor)?
        if len(u) == m + n:
            u.append(0u64)?
        mut q = zeros(m + 1)?
        divide_digits(&mut u, &v, &mut q)
        r = &mut u[:n]
        if factor != 1u64:
            mut carry = 0u64
            mut i = n
            while i > 0:
                i -= 1
                value = (carry << 32u64) | r[i]
                r[i] = value // factor
                carry = value % factor
        Ok((pack32(&q)?, pack32(&r)?))

# Hold scratch row addresses for the complete quotient loop. No list can grow
# while these views exist; normalization and allocation happen in the caller.
def divide_digits(u: &mut [u64], v: &[u64], q: &mut [u64]) -> ():
    unchecked:
        n = len(v)
        m = len(q) - 1
        mut j = m + 1
        while j > 0:
            j -= 1
            numerator = (u[j + n] << 32u64) | u[j + n - 1]
            mut guess = numerator // v[n - 1]
            mut residual = numerator % v[n - 1]
            if guess >= 4294967296u64:
                guess = 4294967295u64
                residual = u[j + n - 1] + v[n - 1]
            if n > 1:
                while residual < 4294967296u64 and guess * v[n - 2] > (residual << 32u64) + u[j + n - 2]:
                    guess -= 1u64
                    residual += v[n - 1]
                    if residual >= 4294967296u64:
                        break
            borrow = subtract_digit_product(&mut u[j:j + n], v, guess)
            negative = u[j + n] < borrow
            u[j + n] = u[j + n].wrapping_sub(borrow) & 4294967295u64
            if negative:
                guess -= 1u64
                mut carry = 0u64
                for i in range(n):
                    total = u[j + i] + v[i] + carry
                    u[j + i] = total & 4294967295u64
                    carry = total >> 32u64
                u[j + n] = (u[j + n] + carry) & 4294967295u64
            q[j] = guess

# In base B = 2^32, complementing the current digit turns subtraction
# into addition: guess*v[i] + borrow + (B-1-row[i]). Its low digit is
# the complement of the result digit, and its high digit is the new borrow.
# The sum is at most (B-1)^2 + 2*(B-1) = B^2-1, so these operations fit u64.
def subtract_digit_product(row: &mut [u64], v: &[u64], guess: u64) -> u64:
    mut borrow = 0u64
    for i in range(len(row)):
        digit = row[i] ^ 4294967295u64
        total = guess.wrapping_mul(v[i]).wrapping_add(borrow).wrapping_add(digit)
        row[i] = (total ^ 4294967295u64) & 4294967295u64
        borrow = total >> 32u64
    borrow

def bitwise(a: &BigInt, b: &BigInt, operation: i64) -> Result[BigInt, AllocError]:
    match &a._value:
        case Value.Small(x):
            match &b._value:
                case Value.Small(y):
                    result = (*x & *y) if operation == 0 else ((*x | *y) if operation == 1 else (*x ^ *y))
                    return Ok(from_i64(result))
                case _:
                    pass
        case _:
            pass
    unchecked:
        n = (a.word_len() if a.word_len() > b.word_len() else b.word_len()) + 1
        mut out = zeros(n)?
        mut ac = a.is_negative()
        mut bc = b.is_negative()
        for i in range(n):
            aw = a.word(i)
            bw = b.word(i)
            (ax, next_a) = (~aw).carrying_add(0u64, ac) if a.is_negative() else (aw, False)
            (bx, next_b) = (~bw).carrying_add(0u64, bc) if b.is_negative() else (bw, False)
            ac = next_a
            bc = next_b
            out[i] = (ax & bx) if operation == 0 else ((ax | bx) if operation == 1 else (ax ^ bx))
        negative = (out[-1] >> 63u64) != 0u64
        if negative:
            mut carry = True
            for i in range(n):
                (word, next) = (~out[i]).carrying_add(0u64, carry)
                out[i] = word
                carry = next
        Ok(canonical(negative, out))
