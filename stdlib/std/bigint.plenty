# Arbitrary precision signed integers. Canonical signed magnitude with inline i64.
# Arithmetic algorithms follow the base-power limb approach described in
# The Art of Computer Programming, vol. 2, sections 4.3.1 and 4.3.3
# (Donald Knuth): schoolbook arithmetic, Knuth division, Karatsuba and Toom-3.
# Large multiplication independently implements small-prime NTT/CRT, with
# 128-bit digit packing and exact Montgomery reduction:
# https://flintlib.org/doc/algorithms/fft/multimodular.html
# Malachite 0.14 informed word-sized digit groups, recursive quotient
# blocks and cached Barrett reciprocals with cyclic correction products.
# No third-party code or data is included.
from std.bytes import to_text, BytesError
from std.fmt import Formatter, FormatError

@copy
pub enum BigIntError:
    InvalidDigit
    InvalidRadix
    LimitExceeded
    OutOfRange
    ZeroDivision
    Allocation(AllocError)

enum Value:
    Small(i64)
    Large(bool, list[u64])

pub class BigInt:
    _value: Value

    pub def is_zero(self) -> bool:
        match &self._value:
            case Value.Small(n):
                *n == 0
            case Value.Large(_, _):
                False

    pub def is_negative(self) -> bool:
        match &self._value:
            case Value.Small(n):
                *n < 0
            case Value.Large(negative, _):
                *negative

    def word_len(self) -> i64:
        match &self._value:
            case Value.Small(n):
                0 if *n == 0 else 1
            case Value.Large(_, words):
                len(words)

    def word(self, index: i64) -> u64:
        if index < 0 or index >= self.word_len():
            return 0u64
        match &self._value:
            case Value.Small(n):
                unchecked:
                    u64(-(*n + 1)) + 1u64 if *n < 0 else u64(*n)
            case Value.Large(_, words):
                words[index]

    pub def cmp(self, other: &BigInt) -> i64:
        if self.is_negative() != other.is_negative():
            return -1 if self.is_negative() else 1
        result = magnitude_cmp(self, other)
        unchecked:
            -result if self.is_negative() else result

    pub def to_i64(self) -> Result[i64, BigIntError]:
        match &self._value:
            case Value.Small(n):
                Ok(*n)
            case Value.Large(_, _):
                Err(BigIntError.OutOfRange)

    pub def to_u64(self) -> Result[u64, BigIntError]:
        if self.is_negative() or self.word_len() > 1:
            return Err(BigIntError.OutOfRange)
        Ok(self.word(0))

    pub def bit_length(self) -> i64:
        if self.is_zero():
            return 0
        unchecked:
            mut high = self.word(self.word_len() - 1)
            mut bits = (self.word_len() - 1) * 64
            while high != 0u64:
                bits += 1
                high >>= 1u64
            bits

    pub def to_f64(self) -> f64:
        unchecked:
            bits = self.bit_length()
            if bits <= 53:
                value = f64(self.word(0))
                return -value if self.is_negative() else value
            if bits > 1024:
                return -f64.INF if self.is_negative() else f64.INF
            shift = bits - 53
            mut top = 0u64
            for i in range(53):
                position = bits - i - 1
                top = (top << 1u64) | ((self.word(position // 64) >> u64(position % 64)) & 1u64)
            guard_position = shift - 1
            guard = ((self.word(guard_position // 64) >> u64(guard_position % 64)) & 1u64) != 0u64
            mut sticky = False
            for i in range(guard_position // 64):
                sticky = sticky or self.word(i) != 0u64
            remaining = u64(guard_position % 64)
            if remaining != 0u64:
                sticky = sticky or (self.word(guard_position // 64) << (64u64 - remaining)) != 0u64
            if guard and (sticky or (top & 1u64) != 0u64):
                top += 1u64
            value = f64(top) * 2.0.pow(f64(shift))
            -value if self.is_negative() else value

    pub def __add__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a + *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        if self.is_negative() == other.is_negative():
            return Ok(canonical(self.is_negative(), magnitude_add(self, other)?))
        order = magnitude_cmp(self, other)
        if order == 0:
            return Ok(from_i64(0))
        if order > 0:
            Ok(canonical(self.is_negative(), magnitude_sub(self, other)?))
        else:
            Ok(canonical(other.is_negative(), magnitude_sub(other, self)?))

    pub def __radd__(self, other: i64) -> Result[BigInt, AllocError]:
        self + from_i64(other)

    pub def __neg__(self) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(n):
                if *n != i64.MIN:
                    unchecked:
                        return Ok(from_i64(-*n))
            case _:
                pass
        Ok(canonical(not self.is_negative(), words(self)?))

    pub def __sub__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a - *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        if self.is_negative() != other.is_negative():
            return Ok(canonical(self.is_negative(), magnitude_add(self, other)?))
        order = magnitude_cmp(self, other)
        if order == 0:
            return Ok(from_i64(0))
        if order > 0:
            Ok(canonical(self.is_negative(), magnitude_sub(self, other)?))
        else:
            Ok(canonical(not self.is_negative(), magnitude_sub(other, self)?))

    pub def __mul__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if self.is_zero() or other.is_zero():
            return Ok(from_i64(0))
        match &self._value:
            case Value.Small(a):
                match &other._value:
                    case Value.Small(b):
                        result = checked:
                            *a * *b
                        match result:
                            case Ok(n):
                                return Ok(from_i64(n))
                            case Err(_):
                                pass
                    case _:
                        pass
            case _:
                pass
        a = words(self)?
        b = words(other)?
        Ok(canonical(self.is_negative() != other.is_negative(), multiply(&a, &b)?))

    pub def add_assign(self: &mut BigInt, other: &BigInt) -> Result[(), AllocError]:
        result = (self + other)?
        self._value = result._value
        Ok(())

    pub def __floordiv__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if other.is_zero():
            __trap("BigInt.__floordiv__: divisor is zero")
        pair = quotient_remainder(self, other)?
        (q, _) = pair
        Ok(q)

    pub def __mod__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        if other.is_zero():
            __trap("BigInt.__mod__: divisor is zero")
        pair = quotient_remainder(self, other)?
        (_, r) = pair
        Ok(r)

    pub def checked_divmod(self, other: &BigInt) -> Result[(BigInt, BigInt), BigIntError]:
        if other.is_zero():
            return Err(BigIntError.ZeroDivision)
        quotient_remainder(self, other).map_error(BigIntError.Allocation)

    pub def __lshift__(self, count: i64) -> Result[BigInt, AllocError]:
        if count < 0:
            __trap("BigInt.__lshift__: count is negative")
        if self.is_zero():
            return Ok(from_i64(0))
        match &self._value:
            case Value.Small(n):
                if count < 63:
                    factor = unchecked:
                        1i64 << count
                    result = checked:
                        *n * factor
                    match result:
                        case Ok(value):
                            return Ok(from_i64(value))
                        case Err(_):
                            pass
                elif count == 63 and *n == -1:
                    return Ok(from_i64(i64.MIN))
            case _:
                pass
        unchecked:
            extra = count // 64
            if extra > i64.MAX - self.word_len() - 1:
                return Err(AllocError.CapacityOverflow)
            mut result = zeros(self.word_len() + extra + 1)?
            shift = u64(count % 64)
            for i in range(self.word_len()):
                value = self.word(i)
                result[i + extra] = result[i + extra] | (value << shift)
                if shift != 0u64:
                    result[i + extra + 1] = value >> (64u64 - shift)
            Ok(canonical(self.is_negative(), result))

    pub def __rshift__(self, count: i64) -> Result[BigInt, AllocError]:
        if count < 0:
            __trap("BigInt.__rshift__: count is negative")
        match &self._value:
            case Value.Small(n):
                if count >= 63:
                    return Ok(from_i64(-1 if *n < 0 else 0))
                unchecked:
                    return Ok(from_i64(*n >> count))
            case _:
                pass
        unchecked:
            extra = count // 64
            if extra >= self.word_len():
                return Ok(from_i64(-1 if self.is_negative() else 0))
            shift = u64(count % 64)
            mut result = zeros(self.word_len() - extra)?
            mut discarded = False
            for i in range(extra):
                discarded = discarded or self.word(i) != 0u64
            if shift != 0u64:
                discarded = discarded or (self.word(extra) << (64u64 - shift)) != 0u64
            for i in range(len(result)):
                result[i] = self.word(i + extra) >> shift
                if shift != 0u64:
                    result[i] = result[i] | (self.word(i + extra + 1) << (64u64 - shift))
            value = canonical(self.is_negative(), result)
            if self.is_negative() and discarded:
                return value - from_i64(1)
            Ok(value)

    pub def __and__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 0)

    pub def __or__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 1)

    pub def __xor__(self, other: &BigInt) -> Result[BigInt, AllocError]:
        bitwise(self, other, 2)

    pub def to_string(self, radix: i64 = 10, max_digits: NonNegative[i64] = 10000) -> Result[str, BigIntError]:
        if radix < 2 or radix > 36:
            return Err(BigIntError.InvalidRadix)
        if self.word_len() <= 1:
            return render_one_word(self, radix, max_digits.get())
        render_large(self, radix, max_digits.get())

    pub def display[W](self, out: &mut Formatter[W]) -> Result[(), FormatError]:
        match self.to_string():
            case Ok(text):
                out.text(text)
            case Err(BigIntError.Allocation(cause)):
                Err(FormatError.Allocation(cause))
            case Err(_):
                Err(FormatError.LimitExceeded)

pub def from_i64(value: i64) -> BigInt:
    BigInt(Value.Small(value))

pub def from_u64(value: u64) -> Result[BigInt, AllocError]:
    if value <= 9223372036854775807u64:
        unchecked:
            return Ok(from_i64(i64(value)))
    Ok(canonical(False, [value]?))

pub def parse(text: &strview, radix: i64 = 10, max_digits: NonNegative[i64] = 10000) -> Result[BigInt, BigIntError]:
    if radix < 2 or radix > 36:
        return Err(BigIntError.InvalidRadix)
    data = text.as_bytes()
    if len(data) == 0:
        return Err(BigIntError.InvalidDigit)
    negative = data[0] == 45u8
    start = 1 if negative or data[0] == 43u8 else 0
    unchecked:
        if len(data) - start > max_digits.get():
            return Err(BigIntError.LimitExceeded)
        if start == len(data):
            return Err(BigIntError.InvalidDigit)
        for i in range(start, len(data)):
            digit = digit_value(data[i])
            if digit < 0 or digit >= radix:
                return Err(BigIntError.InvalidDigit)
        value = if len(data) - start <= 12:
            parse_small(data, start, len(data), radix)
        else:
            mut powers = RadixPowers(radix, dict[i64, BigInt]().map_error(BigIntError.Allocation)?, Nothing)
            parse_digits(data, start, len(data), radix, &mut powers).map_error(BigIntError.Allocation)?
        if negative:
            (-value).map_error(BigIntError.Allocation)
        else:
            Ok(value)

def digit_value(ch: u8) -> i64:
    unchecked:
        if ch >= 48u8 and ch <= 57u8:
            i64(ch - 48u8)
        elif ch >= 65u8 and ch <= 90u8:
            i64(ch - 65u8) + 10
        elif ch >= 97u8 and ch <= 122u8:
            i64(ch - 97u8) + 10
        else:
            -1

# Compute each exact power from its halved exponent. Normalized
# divisors and their optional reciprocals belong to one conversion.
class RadixPowers:
    radix: i64
    exact: dict[i64, BigInt]
    prepared: Option[dict[i64, WideDivisor]]

    def power(self: &mut RadixPowers, exponent: i64) -> Result[&BigInt, AllocError]:
        if exponent not in self.exact:
            self.compute(exponent)?
        Ok(self.exact.get_ref(exponent).unwrap())

    def divide(self: &mut RadixPowers, value: &BigInt, exponent: i64, reuse: bool) -> Result[(list[u64], list[u64]), AllocError]:
        if exponent not in self.exact:
            self.compute(exponent)?
        power = self.exact.get_ref(exponent).unwrap()
        if power.word_len() < WIDE_DIVISION_LIMBS or magnitude_cmp(value, power) < 0:
            return divide_narrow(value, power)
        if self.prepared.is_none():
            self.prepared = Some(dict[i64, WideDivisor]()?)
        match &mut self.prepared:
            case Some(divisors):
                if exponent not in divisors:
                    divisors.insert(exponent, prepare_wide_divisor(power)?)?
                divisor = divisors.get_mut(exponent).unwrap()
                if reuse:
                    divisor.prepare_radix_reciprocal(value.word_len())?
                divide_wide(value, divisor, RADIX_DIVISION_BLOCK_LIMBS)
            case Nothing:
                __trap("std.bigint: missing prepared divisor cache")

    def compute(self: &mut RadixPowers, exponent: i64) -> Result[(), AllocError]:
        unchecked:
            if exponent <= 1:
                self.exact.insert(exponent, from_i64(1 if exponent == 0 else self.radix))?
                return Ok(())
            half = self.power(exponent // 2)?
            square = (half * half)?
            result = if exponent % 2 == 0:
                square
            else:
                (square * from_i64(self.radix))?
            self.exact.insert(exponent, result)?
            Ok(())

def parse_small(data: &[u8], start: i64, stop: i64, radix: i64) -> BigInt:
    unchecked:
        mut value = 0
        for i in range(start, stop):
            value = value * radix + digit_value(data[i])
        from_i64(value)

def parse_digits(data: &[u8], start: i64, stop: i64, radix: i64, powers: &mut RadixPowers) -> Result[BigInt, AllocError]:
    unchecked:
        if stop - start <= 12:
            return Ok(parse_small(data, start, stop, radix))
        middle = start + (stop - start) // 2
        left = parse_digits(data, start, middle, radix, &mut powers)?
        right = parse_digits(data, middle, stop, radix, &mut powers)?
        power = powers.power(stop - middle)?
        shifted = (left * power)?
        shifted + right

# A word-sized radix power lets short division extract a full group of
# digits at a time. Normalize the divisor and invert it once per render.
@copy
class RadixChunk:
    width: i64
    log_floor: i64
    shift: u64
    divisor: u64
    inverse: u64

def radix_chunk(radix: u64) -> RadixChunk:
    unchecked:
        mut divisor = radix
        mut width = 1
        while divisor <= u64.MAX // radix:
            divisor *= radix
            width += 1
        mut bits = 0
        mut high = divisor
        while high > 1u64:
            high >>= 1u64
            bits += 1
        shift = u64(63 - bits)
        normalized = divisor << shift
        RadixChunk(width, bits, shift, normalized, inverse_division_word(normalized))

def render_one_word(value: &BigInt, radix: i64, limit: i64) -> Result[str, BigIntError]:
    unchecked:
        word = value.word(0)
        mut count = word
        mut width = 1
        while count >= u64(radix):
            count //= u64(radix)
            width += 1
        if width > limit:
            return Err(BigIntError.LimitExceeded)
        sign = 1 if value.is_negative() else 0
        mut digits = [0u8 for _ in range(width + sign)].map_error(BigIntError.Allocation)?
        render_word(word, u64(radix), &mut digits[sign:])
        if sign != 0:
            digits[0] = 45u8
        render_text(&digits)

def render_text(digits: &[u8]) -> Result[str, BigIntError]:
    match to_text(digits):
        case Ok(text):
            Ok(text)
        case Err(BytesError.Allocation(cause)):
            Err(BigIntError.Allocation(cause))
        case Err(_):
            __trap("std.bigint: render produced non-ASCII digits")

def render_large(value: &BigInt, radix: i64, limit: i64) -> Result[str, BigIntError]:
    unchecked:
        bits = value.bit_length()
        if radix & (radix - 1) == 0:
            return render_power_of_two(value, u64(radix), bits, limit)
        chunk = radix_chunk(u64(radix))
        # 2^log_floor <= radix^chunk.width < 2^(log_floor + 1).
        # Split the products into quotient and remainder to avoid overflow.
        low_bits = bits - 1
        ceil_log = chunk.log_floor + 1
        lower_whole = (low_bits // ceil_log) * chunk.width
        lower_fraction = ((low_bits % ceil_log) * chunk.width) // ceil_log
        if limit < lower_whole + lower_fraction + 1:
            return Err(BigIntError.LimitExceeded)
        upper_whole = (bits // chunk.log_floor) * chunk.width
        upper_fraction = ((bits % chunk.log_floor) * chunk.width + chunk.log_floor - 1) // chunk.log_floor
        upper = upper_whole + upper_fraction
        mut powers = RadixPowers(radix, dict[i64, BigInt]().map_error(BigIntError.Allocation)?, Nothing)
        if limit < upper:
            powers.compute(limit).map_error(BigIntError.Allocation)?
            boundary = powers.exact.get_ref(limit).unwrap()
            if magnitude_cmp(value, boundary) >= 0:
                return Err(BigIntError.LimitExceeded)
        width = limit if limit < upper else upper
        if width == i64.MAX:
            return Err(BigIntError.Allocation(AllocError.CapacityOverflow))
        # Reserve a byte for an optional minus sign immediately before the
        # first significant digit, including when there is no leading padding.
        mut digits = [0u8 for _ in range(width + 1)].map_error(BigIntError.Allocation)?
        render_digits(value, u64(radix), chunk, &mut digits[1:], width // 2, False, &mut powers).map_error(BigIntError.Allocation)?
        # The magnitude is nonzero, so a significant digit ends this scan.
        mut first = 1
        while digits[first] == 48u8:
            first += 1
        if value.is_negative():
            first -= 1
            digits[first] = 45u8
        render_text(&digits[first:])

def render_power_of_two(value: &BigInt, radix: u64, bits: i64, limit: i64) -> Result[str, BigIntError]:
    unchecked:
        mut group = 1
        mut high = radix >> 1u64
        while high > 1u64:
            high >>= 1u64
            group += 1
        width = (bits - 1) // group + 1
        if width > limit:
            return Err(BigIntError.LimitExceeded)
        sign = 1 if value.is_negative() else 0
        if width == i64.MAX and sign != 0:
            return Err(BigIntError.Allocation(AllocError.CapacityOverflow))
        mut digits = [0u8 for _ in range(width + sign)].map_error(BigIntError.Allocation)?
        alphabet = b"0123456789abcdefghijklmnopqrstuvwxyz"
        for i in range(width):
            position = (width - 1 - i) * group
            word = position // 64
            shift = position % 64
            mut digit = value.word(word) >> u64(shift)
            if shift + group > 64:
                digit |= value.word(word + 1) << u64(64 - shift)
            digits[sign + i] = alphabet[i64(digit & (radix - 1u64))]
        if sign != 0:
            digits[0] = 45u8
        render_text(&digits)

def render_word(value: u64, radix: u64, output: &mut [u8]) -> ():
    unchecked:
        mut n = value
        alphabet = b"0123456789abcdefghijklmnopqrstuvwxyz"
        mut i = len(output)
        while i > 0:
            i -= 1
            q = n // radix
            # q * radix <= n. Form the remainder from the quotient.
            digit = n.wrapping_sub(q.wrapping_mul(radix))
            output[i] = alphabet[i64(digit)]
            n = q


def render_chunks(value: &BigInt, radix: u64, chunk: RadixChunk, output: &mut [u8]) -> Result[(), AllocError]:
    unchecked:
        mut scratch = words(value)?
        mut size = len(scratch)
        mut end = len(output)
        while size > 1:
            remainder = divide_render_chunk(&mut scratch[:size], chunk)
            end -= chunk.width
            render_word(remainder, radix, &mut output[end:end + chunk.width])
            if scratch[size - 1] == 0u64:
                size -= 1
        render_word(scratch[0], radix, &mut output[:end])
        Ok(())

def divide_render_chunk(words: &mut [u64], chunk: RadixChunk) -> u64:
    unchecked:
        shift = chunk.shift
        # Keep the carried remainder normalized. Its low shift bits are
        # zero because the normalized dividend and divisor share that factor.
        mut remainder = 0u64
        mut i = len(words)
        while i > 0:
            i -= 1
            word = words[i]
            hi = remainder | (0u64 if shift == 0u64 else word >> (64u64 - shift))
            (quotient, rest) = estimate_division_word(hi, word << shift, chunk.divisor, chunk.inverse)
            words[i] = quotient
            remainder = rest
        remainder >> shift

def render_digits(value: &BigInt, radix: u64, chunk: RadixChunk, output: &mut [u8], split: i64, reuse: bool, powers: &mut RadixPowers) -> Result[(), AllocError]:
    unchecked:
        if value.word_len() <= 1:
            render_word(value.word(0), radix, output)
            return Ok(())
        if value.word_len() <= 96:
            return render_chunks(value, radix, chunk, output)
        # Use the same right-hand width at each depth so sibling splits
        # share one power and reciprocal even when the widths are odd.
        middle = len(output) - split
        (q, r) = powers.divide(value, split, reuse)?
        left = canonical(False, q)
        right = canonical(False, r)
        render_digits(&left, radix, chunk, &mut output[:middle], split // 2, True, &mut powers)?
        render_digits(&right, radix, chunk, &mut output[middle:], split // 2, True, &mut powers)?
        Ok(())

# Only this constructor can create a large representation. Zero has no sign;
# every value in the signed word range returns to the inline representation.
def canonical(negative: bool, source: list[u64]) -> BigInt:
    mut value = source
    trim(&mut value)
    if len(value) == 0:
        return from_i64(0)
    if len(value) == 1:
        limit = 9223372036854775808u64 if negative else 9223372036854775807u64
        if value[0] <= limit:
            unchecked:
                if negative and value[0] == 9223372036854775808u64:
                    return from_i64(i64.MIN)
                n = -i64(value[0]) if negative else i64(value[0])
                return from_i64(n)
    BigInt(Value.Large(negative, value))

def trim(value: &mut list[u64]) -> ():
    while len(value) > 0:
        if value[-1] != 0u64:
            return
        drop(value.pop())

def zeros(length: i64) -> Result[list[u64], AllocError]:
    [0u64 for _ in range(length)]

def words(value: &BigInt) -> Result[list[u64], AllocError]:
    mut result = list[u64].with_capacity(value.word_len())?
    for i in range(value.word_len()):
        result.append(value.word(i))?
    Ok(result)

def magnitude_cmp(a: &BigInt, b: &BigInt) -> i64:
    if a.word_len() != b.word_len():
        return -1 if a.word_len() < b.word_len() else 1
    unchecked:
        mut i = a.word_len()
        while i > 0:
            i -= 1
            if a.word(i) != b.word(i):
                return -1 if a.word(i) < b.word(i) else 1
    0

def magnitude_add(a: &BigInt, b: &BigInt) -> Result[list[u64], AllocError]:
    unchecked:
        n = a.word_len() if a.word_len() > b.word_len() else b.word_len()
        mut result = list[u64].with_capacity(n + 1)?
        mut carry = False
        for i in range(n):
